---
import Img from './Img.astro';
import type { Page } from './SiteHeader.astro';
import { STATUS_PAGE_URL as statusPage } from '../scripts/status';

interface Props {
    page: Page;
}

const home = Astro.props.page === 'home' ? '' : './';

// 稼働状況は Better Stack のステータスページから読む（src/scripts/status.ts）。名前はステータスページの表示名（public_name）と合わせる
const bots = ['Hanako', 'Ebyroid'];
---

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="brand" href="./">
                    <Img class="brand-avatar" src="hanako-icon.webp" alt="" width={36} />
                    Hanako <span class="ai-badge">TTS</span>
                </a>
                <p>言葉に、声という花を。<br />Discordのチャット読み上げBotです。</p>
                <a class="status-list" href={statusPage} target="_blank" rel="noopener" title="ステータスページを開く">
                    {
                        bots.map((name) => (
                            <span class="status" data-bot={name} data-state="unknown">
                                {name} <span class="status-label">確認中…</span>
                            </span>
                        ))
                    }
                </a>
            </div>
            <div>
                <h2>PRODUCT</h2>
                <ul>
                    <li><a href={`${home}#features`}>機能</a></li>
                    <li><a href={`${home}#pricing`}>料金</a></li>
                    <li><a href={`${home}#compare`}>比較</a></li>
                </ul>
            </div>
            <div>
                <h2>RESOURCES</h2>
                <ul>
                    <li><a href="docs.html">ドキュメント</a></li>
                    <li><a href="docs.html#commands">コマンド一覧</a></li>
                    <li><a href="developers.html">開発者向け</a></li>
                    <li><a href="https://github.com/Ebycow/hanako" target="_blank" rel="noopener">GitHub</a></li>
                </ul>
            </div>
            <div>
                <h2>LEGAL</h2>
                <ul>
                    <li><a href="terms.html">利用規約</a></li>
                    <li><a href="privacy.html">プライバシーポリシー</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Hanako. Operated by <a href="https://github.com/Ebycow" target="_blank" rel="noopener">Ebycow</a>. Made with ♡ and AI.</p>
            <p>DiscordはDiscord Inc.の商標です。このBotはDiscord Inc.とは関係ありません。</p>
        </div>
    </div>
</footer>

<script>
    import { fetchStatuses } from '../scripts/status';

    // Bot ごとの稼働状況を表示する
    const labels: Record<string, string> = {
        operational: '稼働中',
        degraded: '一部不調',
        downtime: '停止中',
        maintenance: 'メンテナンス中',
    };

    const items = document.querySelectorAll<HTMLElement>('.status[data-bot]');
    const show = (item: HTMLElement, state: string) => {
        item.dataset.state = state in labels ? state : 'unknown';
        item.querySelector('.status-label')!.textContent = labels[state] ?? '確認できません';
    };

    fetchStatuses()
        .then((states) => items.forEach((item) => show(item, states.get(item.dataset.bot!) ?? 'unknown')))
        .catch(() => items.forEach((item) => show(item, 'unknown')));
</script>

<style>
    .site-footer {
        position: relative;
        margin-top: 140px;
        padding: 64px 0 40px;
        background: var(--pink-pale);
        font-size: var(--fs-md);
        color: var(--text-muted);
    }

    /* 上のふちを、ふわふわした雲の形にする */
    .site-footer::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: -27px;
        height: 28px;
        background: radial-gradient(circle at 30px 30px, var(--pink-pale) 28px, transparent 29px) repeat-x;
        background-size: 60px 60px;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 30px;
        margin-bottom: 40px;
    }

    .footer-grid h2 {
        margin: 0 0 12px;
        color: var(--pink-ink);
        font-size: var(--fs-sm);
        letter-spacing: 0.1em;
    }

    .footer-grid ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-grid li {
        margin: 2px 0;
    }

    .footer-grid a {
        color: var(--text-muted);
    }

    /* 指で押しやすいよう、リンクの高さを 24px 以上にする */
    .footer-grid li a {
        display: inline-block;
        padding: 2px 0;
    }

    .footer-grid a:hover {
        color: var(--pink-ink);
    }

    .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 10px;
        padding-top: 24px;
        border-top: 2px dashed var(--pink-soft);
        font-size: var(--fs-sm);
        color: var(--text-dim);
    }

    .footer-bottom p {
        margin: 0;
    }

    .status-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
    }

    .status {
        --dot: var(--border-strong);
        --ring: var(--border);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: var(--fs-sm);
        font-weight: 700;
        padding: 4px 14px;
        border-radius: var(--radius-pill);
        background: var(--surface);
        color: var(--text-dim);
        border: 2px solid var(--ring);
    }

    .status::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--dot);
        box-shadow: 0 0 0 3px var(--ring);
    }

    .status-list:hover .status {
        background: var(--pink-pale);
    }

    .status[data-state='operational'] {
        --dot: var(--mint);
        --ring: var(--mint-soft);
        color: var(--mint-ink);
    }

    .status[data-state='degraded'] {
        --dot: var(--yellow);
        --ring: var(--yellow-line);
        color: var(--text);
    }

    .status[data-state='downtime'] {
        --dot: var(--red);
        --ring: var(--pink-soft);
        color: var(--red);
    }

    .status[data-state='maintenance'] {
        --dot: var(--lavender);
        --ring: var(--lavender-line);
        color: var(--lavender-ink);
    }

    @media (max-width: 960px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
