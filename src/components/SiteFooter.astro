---
import type { Page } from './SiteHeader.astro';

interface Props {
    page: Page;
}

const home = Astro.props.page === 'home' ? '' : './';
---

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="brand" href="./">
                    <img class="brand-avatar" src="assets/hanako-icon.webp" alt="" />
                    Hanako <span class="ai-badge">TTS</span>
                </a>
                <p>言葉に、声という花を。<br />Discordのチャット読み上げBotです。</p>
                <span class="status">All systems operational</span>
            </div>
            <div>
                <h5>PRODUCT</h5>
                <ul>
                    <li><a href={`${home}#features`}>機能</a></li>
                    <li><a href={`${home}#pricing`}>料金</a></li>
                    <li><a href={`${home}#compare`}>比較</a></li>
                </ul>
            </div>
            <div>
                <h5>RESOURCES</h5>
                <ul>
                    <li><a href="docs.html">ドキュメント</a></li>
                    <li><a href="docs.html#commands">コマンド一覧</a></li>
                    <li><a href={`${home}#developers`}>開発者向け</a></li>
                    <li><a href="https://github.com/Ebycow/hanako" target="_blank" rel="noopener">GitHub</a></li>
                </ul>
            </div>
            <div>
                <h5>LEGAL</h5>
                <ul>
                    <li><a href="terms.html">利用規約</a></li>
                    <li><a href="privacy.html">プライバシーポリシー</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Hanako. Operated by <a href="https://github.com/Ebycow" target="_blank" rel="noopener">Ebycow</a>. Made with ♡ and AI.</p>
            <p>DiscordはDiscord Inc.の商標です。このBotはDiscord Inc.とは関係ありません。</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        position: relative;
        margin-top: 140px;
        padding: 64px 0 40px;
        background: var(--pink-pale);
        font-size: 14px;
        color: var(--text-muted);
    }

    /* 上のふちを、ふわふわした雲の形にする */
    .site-footer::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: -27px;
        height: 28px;
        background: radial-gradient(circle at 30px 30px, var(--pink-pale) 28px, transparent 29px) repeat-x;
        background-size: 60px 60px;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 30px;
        margin-bottom: 40px;
    }

    .footer-grid h5 {
        margin: 0 0 12px;
        color: var(--pink-ink);
        font-size: 13px;
        letter-spacing: 0.1em;
    }

    .footer-grid ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-grid li {
        margin: 6px 0;
    }

    .footer-grid a {
        color: var(--text-muted);
    }

    .footer-grid a:hover {
        color: var(--pink-ink);
    }

    .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 10px;
        padding-top: 24px;
        border-top: 2px dashed var(--pink-soft);
        font-size: 13px;
        color: var(--text-dim);
    }

    .footer-bottom p {
        margin: 0;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        font-size: 13px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 999px;
        background: var(--surface);
        color: var(--mint-ink);
        border: 2px solid var(--mint-soft);
    }

    .status::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--mint);
        box-shadow: 0 0 0 3px var(--mint-soft);
    }

    @media (max-width: 960px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
