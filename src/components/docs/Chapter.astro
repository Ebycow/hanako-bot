---
import Img from '../Img.astro';
interface Props {
    id: string;
    /** 章番号（Docs.astro の並び順から自動で振られる） */
    n: number;
    kicker: string;
    mascot: string;
    mascotAlt?: string;
    class?: string;
}

const { id, n, kicker, mascot, mascotAlt = '', class: className } = Astro.props;
const nn = String(n).padStart(2, '0');
---

<section class:list={['chapter', className]} id={id}>
    <div class="chapter-head">
        <div>
            <span class="chapter-kicker">CHAPTER {nn} / {kicker}</span>
            <h2><slot name="title" /></h2>
        </div>
        <Img class="chapter-mascot" src={mascot} alt={mascotAlt} width={104} />
    </div>
    <slot />
</section>

<style>
    .chapter {
        padding: 0 0 90px;
    }

    .chapter-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .chapter-kicker {
        display: inline-block;
        font-size: 12px;
        font-weight: 900;
        color: var(--mint-ink);
        background: var(--mint-soft);
        border-radius: 999px;
        padding: 1px 14px;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
    }

    h2 {
        font-size: clamp(26px, 3.4vw, 38px);
        line-height: 1.4;
        margin: 0;
    }

    /* はなこを丸いふちどりの中に置く */
    .chapter-mascot {
        width: 104px;
        height: 104px;
        object-fit: contain;
        flex-shrink: 0;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 40%, #fff, var(--pink-pale) 70%);
        border: 3px solid var(--pink-soft);
        padding: 6px;
    }

    /* ここから下は各章（docs/*.astro）からスロットで渡される本文に効かせる */
    .chapter :global(.lead) {
        font-size: 18px;
        color: var(--text-muted);
        margin: 0 0 28px;
    }

    .chapter :global(h3) {
        font-size: 21px;
        margin: 48px 0 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 8px;
        border-bottom: 2px dashed var(--border);
    }

    .chapter :global(p),
    .chapter :global(li) {
        color: var(--text);
    }

    .chapter :global(ul) {
        padding-left: 0;
        list-style: none;
    }

    .chapter :global(ul li) {
        position: relative;
        padding-left: 30px;
        margin-bottom: 10px;
    }

    .chapter :global(ul li::before) {
        content: '✓';
        position: absolute;
        left: 0;
        top: 0.3em;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
        color: #fff;
        background: var(--pink);
    }

    .chapter :global(strong) {
        color: var(--pink-deep);
    }

    @media (max-width: 640px) {
        .chapter-mascot {
            width: 68px;
            height: 68px;
            padding: 4px;
        }
    }
</style>
