---
// 使い方ガイド（docs.html）の目次と本文
import { chapters, type ChapterId } from '../../data/chapters';
import Start from './Start.astro';
import Input from './Input.astro';
import Reading from './Reading.astro';
import Dictionary from './Dictionary.astro';
import SoundEffects from './SoundEffects.astro';
import Voice from './Voice.astro';
import Blacklist from './Blacklist.astro';
import Admin from './Admin.astro';
import Commands from './Commands.astro';
import Faq from './Faq.astro';

// 章の id と本文の対応。並び順は src/data/chapters.ts
const bodies: Record<ChapterId, typeof Start> = {
    start: Start,
    input: Input,
    reading: Reading,
    dictionary: Dictionary,
    se: SoundEffects,
    voice: Voice,
    blacklist: Blacklist,
    admin: Admin,
    commands: Commands,
    trouble: Faq,
};
const nn = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="docs">
    <nav class="toc" aria-label="目次">
        <p>目次</p>
        <ol>
            {chapters.map((c, i) => <li><a href={`#${c.id}`}>{nn(i)}. {c.label}</a></li>)}
        </ol>
    </nav>

    <div>
        {
            chapters.map(({ id }, i) => {
                const Chapter = bodies[id];
                return <Chapter id={id} n={i + 1} />;
            })
        }
    </div>
</div>

<script>
    // 目次の現在位置ハイライト
    if ('IntersectionObserver' in window) {
        const links = new Map<string, HTMLAnchorElement>();
        document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((a) => {
            links.set(a.getAttribute('href')!.slice(1), a);
        });
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    links.forEach((a, id) => a.classList.toggle('active', id === entry.target.id));
                });
            },
            { rootMargin: '-20% 0px -70% 0px' },
        );
        document.querySelectorAll('.chapter').forEach((section) => observer.observe(section));
    }
</script>

<style>
    .docs {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 48px;
        align-items: start;
    }

    /* 目次 */
    .toc {
        position: sticky;
        top: 110px;
        padding: 20px 16px;
        border-radius: var(--radius);
        background: var(--surface);
        border: 2px solid var(--border);
        box-shadow: var(--pop);
        font-size: var(--fs-md);
        font-weight: 700;
    }

    .toc p {
        margin: 0 0 10px;
        font-size: var(--fs-xs);
        font-weight: 900;
        letter-spacing: 0.1em;
        color: var(--pink-ink);
        padding-left: 12px;
    }

    .toc ol {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .toc a {
        display: block;
        padding: 5px 12px;
        border-radius: var(--radius-pill);
        color: var(--text-muted);
    }

    .toc a:hover {
        color: var(--pink-ink);
        background: var(--pink-pale);
    }

    .toc a.active {
        color: var(--on-accent);
        background: var(--pink-ink);
    }

    @media (max-width: 960px) {
        .docs {
            grid-template-columns: 1fr;
        }
        .toc {
            position: static;
        }
        .toc ol {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
    }
</style>
