---
import Img from './Img.astro';
export type Page = 'home' | 'docs' | 'terms' | 'privacy';

interface Props {
    page: Page;
}

const { page } = Astro.props;
const isHome = page === 'home';
// トップページ内ではページ内リンク、ほかのページからはトップページへのリンクにする
const home = isHome ? '' : './';

type Link = { href: string; label: string; current?: boolean };
const links: Link[] = {
    home: [
        { href: '#features', label: '機能' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'docs.html#commands', label: 'コマンド' },
        { href: '#pricing', label: '料金' },
        { href: 'docs.html#trouble', label: 'FAQ' },
        { href: '#developers', label: '開発者' },
    ],
    // ガイドの中は章へのページ内リンクにする
    docs: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント', current: true },
        { href: '#commands', label: 'コマンド' },
        { href: '#trouble', label: 'FAQ' },
        { href: './#developers', label: '開発者' },
    ],
    terms: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'terms.html', label: '利用規約', current: true },
        { href: 'privacy.html', label: 'プライバシー' },
    ],
    privacy: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'terms.html', label: '利用規約' },
        { href: 'privacy.html', label: 'プライバシー', current: true },
    ],
}[page];
---

<header class="site-header">
    <div class="inner">
        <a class="brand" href="./">
            <Img class="brand-avatar" src="hanako-icon.webp" alt="" width={36} loading="eager" />
            Hanako <span class="ai-badge">TTS</span>
        </a>
        <nav class="site-nav" aria-label="メインナビゲーション">
            {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
            <a class="btn btn-primary btn-sm" href={`${home}#invite`}>はじめる →</a>
        </nav>
    </div>
</header>

<style>
    .site-header {
        position: sticky;
        top: 12px;
        z-index: 20;
        margin: 12px auto 0;
        max-width: calc(var(--max-width) - 40px);
        width: calc(100% - 32px);
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 2px solid var(--border);
        border-radius: 999px;
        box-shadow: 0 4px 0 var(--pink-soft);
    }

    .inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 7px 8px 7px 12px;
    }

    .site-nav {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .site-nav a {
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* 「今すぐ始める」ボタン（.btn）の色や大きさは変えない */
    .site-nav a:not(.btn) {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 999px;
    }

    .site-nav a:not(.btn):hover,
    .site-nav a[aria-current='page'] {
        color: var(--pink-ink);
        background: var(--pink-pale);
    }

    .site-nav .btn {
        margin: 0 0 3px 6px;
    }

    @media (max-width: 640px) {
        .site-header {
            border-radius: 24px;
        }
        .inner {
            flex-wrap: wrap;
            padding: 10px 14px;
        }
        .site-nav {
            width: 100%;
            overflow-x: auto;
        }
        .site-nav .btn {
            display: none;
        }
    }
</style>
