---
import Img from './Img.astro';
export type Page = 'home' | 'docs' | 'developers' | 'terms' | 'privacy';

interface Props {
    page: Page;
}

const { page } = Astro.props;
const isHome = page === 'home';
// トップページ内ではページ内リンク、ほかのページからはトップページへのリンクにする
const home = isHome ? '' : './';

type Link = { href: string; label: string; current?: boolean };
const links: Link[] = {
    home: [
        { href: '#features', label: '機能' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'docs.html#commands', label: 'コマンド' },
        { href: '#pricing', label: '料金' },
        { href: 'docs.html#trouble', label: 'FAQ' },
        { href: 'developers.html', label: '開発者' },
    ],
    // ガイドの中は章へのページ内リンクにする
    docs: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント', current: true },
        { href: '#commands', label: 'コマンド' },
        { href: '#trouble', label: 'FAQ' },
        { href: 'developers.html', label: '開発者' },
    ],
    developers: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'developers.html', label: '開発者', current: true },
        { href: '#self-host', label: 'ホスト手順' },
        { href: '#ask-ai', label: 'AIに相談' },
    ],
    terms: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'terms.html', label: '利用規約', current: true },
        { href: 'privacy.html', label: 'プライバシー' },
    ],
    privacy: [
        { href: './', label: 'ホーム' },
        { href: 'docs.html', label: 'ドキュメント' },
        { href: 'terms.html', label: '利用規約' },
        { href: 'privacy.html', label: 'プライバシー', current: true },
    ],
}[page];
---

<header class="site-header" id="site-header">
    <div class="inner">
        <a class="brand" href="./">
            <Img class="brand-avatar" src="hanako-icon.webp" alt="" width={36} loading="eager" />
            Hanako <span class="ai-badge">TTS</span>
        </a>
        {/* タブレット以下で出るメニューの開閉ボタン */}
        <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
            <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            メニュー
        </button>
        <nav class="site-nav" id="site-nav" aria-label="メインナビゲーション">
            {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
            {/* サイト全体のアニメーションを止める・再開する（押されている＝止まっている） */}
            <button class="motion-toggle" id="motion-toggle" type="button" aria-pressed="false" title="アニメーションを止める">
                <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"
                    ><rect x="6" y="5" width="4" height="14" rx="1.5" fill="currentColor"></rect><rect x="14" y="5" width="4" height="14" rx="1.5" fill="currentColor"></rect></svg
                >
                <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
                <span class="motion-label">アニメーションを止める</span>
            </button>
            <a class="btn btn-primary btn-sm" href={`${home}#invite`}>はなこに会う？</a>
        </nav>
    </div>
</header>

<script>
    import { isMotionOff, setMotionOff, onMotionChange } from '../scripts/motion';

    // アニメーションを止めるボタン
    const motionToggle = document.getElementById('motion-toggle')!;
    const syncMotion = (off: boolean) => {
        motionToggle.setAttribute('aria-pressed', String(off));
        motionToggle.title = off ? 'アニメーションを止めています（押すと再開）' : 'アニメーションを止める';
    };
    syncMotion(isMotionOff());
    motionToggle.addEventListener('click', () => setMotionOff(!isMotionOff()));
    onMotionChange(syncMotion);

    // スマホのメニューの開閉。リンクを選ぶ・Escキー・メニューの外を押すと閉じる
    const header = document.getElementById('site-header')!;
    const toggle = document.getElementById('menu-toggle')!;
    const nav = document.getElementById('site-nav')!;

    const setOpen = (open: boolean) => {
        header.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    nav.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !header.classList.contains('is-open')) return;
        setOpen(false);
        toggle.focus();
    });
    document.addEventListener('click', (e) => {
        if (!header.contains(e.target as Node)) setOpen(false);
    });
</script>

<style>
    .site-header {
        position: sticky;
        top: 12px;
        z-index: 20;
        margin: 12px auto 0;
        max-width: calc(var(--max-width) - 40px);
        width: calc(100% - 32px);
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 2px solid var(--border);
        border-radius: var(--radius-pill);
        box-shadow: 0 4px 0 var(--pink-soft);
    }

    .inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 7px 8px 7px 12px;
    }

    .site-nav {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .site-nav a {
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* 「今すぐ始める」ボタン（.btn）の色や大きさは変えない */
    .site-nav a:not(.btn) {
        color: var(--text-muted);
        font-size: var(--fs-md);
        font-weight: 700;
        padding: 6px 14px;
        border-radius: var(--radius-pill);
    }

    .site-nav a:not(.btn):hover,
    .site-nav a[aria-current='page'] {
        color: var(--pink-ink);
        background: var(--pink-pale);
    }

    .site-nav .btn {
        margin: 0 0 3px 6px;
    }

    /* アニメーションを止めるボタン。JavaScript で切り替えるので、動かないときは出さない */
    .motion-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        margin-left: 4px;
        padding: 0;
        border-radius: 50%;
        border: 2px solid var(--pink-soft);
        background: var(--surface);
        color: var(--pink-ink);
        font: inherit;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    :global(.js) .motion-toggle {
        display: inline-flex;
    }

    .motion-toggle:hover {
        background: var(--pink-pale);
    }

    .motion-toggle[aria-pressed='true'] {
        background: var(--pink-pale);
        border-color: var(--pink-ink);
    }

    .motion-toggle svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .icon-play,
    .motion-toggle[aria-pressed='true'] .icon-pause {
        display: none;
    }

    .motion-toggle[aria-pressed='true'] .icon-play {
        display: block;
    }

    /* PC ではアイコンだけにし、名前は読み上げソフトと title で伝える */
    .motion-label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* メニューの開閉ボタン（タブレット以下で JavaScript が動くときだけ出す） */
    .menu-toggle {
        display: none;
        align-items: center;
        gap: 8px;
        min-height: 40px;
        padding: 6px 16px 6px 12px;
        border-radius: var(--radius-pill);
        border: 2px solid var(--pink-soft);
        background: var(--surface);
        color: var(--pink-ink);
        font: inherit;
        font-size: var(--fs-md);
        font-weight: 900;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .menu-toggle[aria-expanded='true'] {
        background: var(--pink-pale);
    }

    .menu-icon {
        display: grid;
        gap: 3px;
        width: 16px;
    }

    .menu-icon i {
        display: block;
        height: 2px;
        border-radius: var(--radius-xs);
        background: currentColor;
        transition:
            transform 0.2s,
            opacity 0.2s;
    }

    /* 開いているときは × にする */
    .is-open .menu-icon i:nth-child(1) {
        transform: translateY(5px) rotate(45deg);
    }

    .is-open .menu-icon i:nth-child(2) {
        opacity: 0;
    }

    .is-open .menu-icon i:nth-child(3) {
        transform: translateY(-5px) rotate(-45deg);
    }

    /* ナビが1行に収まらない幅（タブレット以下）では、メニューボタンで開く形にする */
    @media (max-width: 860px) {
        .site-header {
            border-radius: var(--radius);
        }
        .inner {
            flex-wrap: wrap;
            gap: 8px;
            padding: 7px 7px 7px 12px;
        }

        /* JavaScript が動かないときは、リンクを横に並べてスクロールさせる */
        .site-nav {
            width: 100%;
            overflow-x: auto;
        }
        .site-nav .btn {
            display: none;
        }

        /* JavaScript が動くときは、メニューボタンで縦に開く */
        :global(.js) .menu-toggle {
            display: inline-flex;
        }
        :global(.js) .site-nav {
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 2px;
            padding: 4px 0 6px;
            overflow: visible;
            border-top: 2px dashed var(--border);
        }
        :global(.js) .is-open .site-nav {
            display: flex;
        }
        :global(.js) .site-nav a:not(.btn) {
            padding: 10px 14px;
            font-size: var(--fs-base);
        }
        /* スマホのメニューの中では、文字も出して1行のボタンにする */
        :global(.js) .motion-toggle {
            justify-content: flex-start;
            width: auto;
            height: auto;
            margin: 4px 0 0;
            padding: 10px 14px;
            border-radius: var(--radius-pill);
            font-size: var(--fs-base);
            font-weight: 700;
        }
        .motion-label {
            position: static;
            width: auto;
            height: auto;
            clip-path: none;
        }
        :global(.js) .site-nav .btn {
            display: inline-flex;
            justify-content: center;
            margin: 8px 0 4px;
            padding: 11px 16px;
            font-size: var(--fs-base);
        }
    }
</style>
