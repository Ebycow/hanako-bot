---
import { limits, fmt } from '../../data/limits';
---

<section class="section" id="compare">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">✦ Why Hanako</span>
            <h2>なぜ、<span class="gradient-text">Hanakoなのか。</span></h2>
            <p>その違いは、一目瞭然です。</p>
        </div>
        <div class="table-wrap compare reveal">
            <table>
                <thead>
                    <tr>
                        <th></th>
                        <th>読み上げなし</th>
                        <th>✨ Hanako</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>聞き専でもチャットがわかる</td>
                        <td class="no">✕</td>
                        <td class="yes">✓</td>
                    </tr>
                    <tr>
                        <td>内輪ネタを正しく読める辞書</td>
                        <td class="no">✕</td>
                        <td class="yes">✓（{fmt(limits.dictionaryEntries)}件）</td>
                    </tr>
                    <tr>
                        <td>キーワードで効果音</td>
                        <td class="no">✕</td>
                        <td class="yes">✓（{fmt(limits.seEntries)}件）</td>
                    </tr>
                    <tr>
                        <td>長文を途中で成敗</td>
                        <td class="no">✕</td>
                        <td class="yes">✓</td>
                    </tr>
                    <tr>
                        <td>料金</td>
                        <td>¥0</td>
                        <td class="yes">¥0</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<style>
    /* Hanako の列を強調する */
    .compare td:nth-child(3),
    .compare th:nth-child(3) {
        background: rgba(139, 92, 246, 0.1);
    }

    .yes {
        color: #4ade80;
        font-weight: 800;
    }

    .no {
        color: #f87171;
        font-weight: 800;
    }
</style>
