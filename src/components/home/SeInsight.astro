---
import { limits, fmt } from '../../data/limits';
---

        <section class="section" id="insights">
            <div class="container">
                <div class="section-head reveal">
                    <span class="eyebrow">Killer Feature</span>
                    <h2>最強機能、<span class="hl">SE。</span><br />強すぎて、困っちゃう。</h2>
                    <p>
                        キーワードに音声ファイルを結びつけるだけで、その言葉が出た瞬間に効果音が鳴る。wav / mp3 を1サーバーあたり最大<strong>{fmt(limits.seEntries)}件</strong>。会話は一気にライブ会場へ——と思ったら、みんなが登録しすぎて、はなこも困っています。
                    </p>
                </div>
                <div class="card chart-card reveal">
                    <img class="chart-mascot" src="assets/hanako-surprised.webp" alt="" loading="lazy" />
                    <div class="chart-top">
                        <div>
                            <b>SE登録数 × はなこの困り度</b>
                            <small>FY2026 · とあるサーバー · 月次</small>
                        </div>
                        <div class="chart-legend">
                            <span><i class="lg-bar"></i>SE登録数（左軸）</span>
                            <span><i class="lg-line"></i>困り度（右軸）</span>
                        </div>
                    </div>
                    <div class="chart-kpis">
                        <div><b class="hl">+1,083%</b><small>SE登録数 前年比</small></div>
                        <div><b class="hl">97%</b><small>はなこの困り度</small></div>
                        <div><b class="hl">300件</b><small>上限まで残り</small></div>
                    </div>
                    <div class="chart-scroll"><svg class="combo-chart" viewBox="0 0 1000 380" role="img" aria-labelledby="chart-title chart-desc">
<title id="chart-title">SE登録数とはなこの困り度の推移（架空）</title><desc id="chart-desc">架空のデータによる棒グラフと折れ線グラフの複合グラフ。SEの登録数が上限の10,000件に近づくにつれ、はなこの困り度も上がっている。</desc>
<defs><linearGradient id="barg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff9cc2"/><stop offset="1" stop-color="#ffd3e3" stop-opacity=".6"/></linearGradient><linearGradient id="lineg" x1="0" x2="1"><stop offset="0" stop-color="#3cc0b5"/><stop offset="1" stop-color="#d6336f"/></linearGradient><linearGradient id="areag" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f472b6" stop-opacity=".22"/><stop offset="1" stop-color="#f472b6" stop-opacity="0"/></linearGradient></defs>
<line x1="78" x2="930" y1="30" y2="30" class="grid"/>
<text x="68" y="34" class="axl" text-anchor="end">10,000</text>
<text x="940" y="34" class="axr">100%</text>
<line x1="78" x2="930" y1="102" y2="102" class="grid"/>
<text x="68" y="106" class="axl" text-anchor="end">7,500</text>
<text x="940" y="106" class="axr">75%</text>
<line x1="78" x2="930" y1="175" y2="175" class="grid"/>
<text x="68" y="179" class="axl" text-anchor="end">5,000</text>
<text x="940" y="179" class="axr">50%</text>
<line x1="78" x2="930" y1="248" y2="248" class="grid"/>
<text x="68" y="252" class="axl" text-anchor="end">2,500</text>
<text x="940" y="252" class="axr">25%</text>
<line x1="78" x2="930" y1="320" y2="320" class="grid"/>
<text x="68" y="324" class="axl" text-anchor="end">0</text>
<text x="940" y="324" class="axr">0%</text>
<line x1="78" x2="930" y1="30" y2="30" class="limit"/><text x="86" y="22" class="limit-label">上限 10,000件</text>
<rect x="92.2" y="296.2" width="42.6" height="23.8" rx="6" fill="url(#barg)" class="cbar" style="--d:0ms"/>
<text x="113.5" y="344" class="axx" text-anchor="middle">1月</text>
<rect x="163.2" y="272.1" width="42.6" height="47.9" rx="6" fill="url(#barg)" class="cbar" style="--d:60ms"/>
<text x="184.5" y="344" class="axx" text-anchor="middle">2月</text>
<rect x="234.2" y="253.3" width="42.6" height="66.7" rx="6" fill="url(#barg)" class="cbar" style="--d:120ms"/>
<text x="255.5" y="344" class="axx" text-anchor="middle">3月</text>
<rect x="305.2" y="230.1" width="42.6" height="89.9" rx="6" fill="url(#barg)" class="cbar" style="--d:180ms"/>
<text x="326.5" y="344" class="axx" text-anchor="middle">4月</text>
<rect x="376.2" y="206.9" width="42.6" height="113.1" rx="6" fill="url(#barg)" class="cbar" style="--d:240ms"/>
<text x="397.5" y="344" class="axx" text-anchor="middle">5月</text>
<rect x="447.2" y="186.6" width="42.6" height="133.4" rx="6" fill="url(#barg)" class="cbar" style="--d:300ms"/>
<text x="468.5" y="344" class="axx" text-anchor="middle">6月</text>
<rect x="518.2" y="160.5" width="42.6" height="159.5" rx="6" fill="url(#barg)" class="cbar" style="--d:360ms"/>
<text x="539.5" y="344" class="axx" text-anchor="middle">7月</text>
<rect x="589.2" y="137.3" width="42.6" height="182.7" rx="6" fill="url(#barg)" class="cbar" style="--d:420ms"/>
<text x="610.5" y="344" class="axx" text-anchor="middle">8月</text>
<rect x="660.2" y="111.2" width="42.6" height="208.8" rx="6" fill="url(#barg)" class="cbar" style="--d:480ms"/>
<text x="681.5" y="344" class="axx" text-anchor="middle">9月</text>
<rect x="731.2" y="88.0" width="42.6" height="232.0" rx="6" fill="url(#barg)" class="cbar" style="--d:540ms"/>
<text x="752.5" y="344" class="axx" text-anchor="middle">10月</text>
<rect x="802.2" y="61.9" width="42.6" height="258.1" rx="6" fill="url(#barg)" class="cbar" style="--d:600ms"/>
<text x="823.5" y="344" class="axx" text-anchor="middle">11月</text>
<rect x="873.2" y="38.7" width="42.6" height="281.3" rx="6" fill="url(#barg)" class="cbar" style="--d:660ms"/>
<text x="894.5" y="344" class="axx" text-anchor="middle">12月</text>
<path d="M113.5,305.5 L184.5,296.8 L255.5,291.0 L326.5,267.8 L397.5,256.2 L468.5,233.0 L539.5,209.8 L610.5,189.5 L681.5,151.8 L752.5,128.6 L823.5,88.0 L894.5,38.7 L894.5,320 L113.5,320 Z" fill="url(#areag)"/>
<path d="M113.5,305.5 L184.5,296.8 L255.5,291.0 L326.5,267.8 L397.5,256.2 L468.5,233.0 L539.5,209.8 L610.5,189.5 L681.5,151.8 L752.5,128.6 L823.5,88.0 L894.5,38.7" fill="none" stroke="url(#lineg)" stroke-width="3.5" stroke-linejoin="round" class="cline"/>
<circle cx="113.5" cy="305.5" r="5" class="cdot"/>
<circle cx="184.5" cy="296.8" r="5" class="cdot"/>
<circle cx="255.5" cy="291.0" r="5" class="cdot"/>
<circle cx="326.5" cy="267.8" r="5" class="cdot"/>
<circle cx="397.5" cy="256.2" r="5" class="cdot"/>
<circle cx="468.5" cy="233.0" r="5" class="cdot"/>
<circle cx="539.5" cy="209.8" r="5" class="cdot"/>
<circle cx="610.5" cy="189.5" r="5" class="cdot"/>
<circle cx="681.5" cy="151.8" r="5" class="cdot"/>
<circle cx="752.5" cy="128.6" r="5" class="cdot"/>
<circle cx="823.5" cy="88.0" r="5" class="cdot"/>
<circle cx="894.5" cy="38.7" r="5" class="cdot"/>
<g class="annot"><line x1="326.5" y1="267.8" x2="326.5" y2="177.8"/><text x="326.5" y="169.8" text-anchor="middle">🌱「草」を登録 → 草原でも鳴る</text></g>
<g class="annot"><line x1="610.5" y1="189.5" x2="610.5" y2="119.5"/><text x="610.5" y="111.5" text-anchor="middle">🎺（拍手）が3種類に</text></g>
<g class="annot"><line x1="894.5" y1="38.7" x2="784.5" y2="64.7"/><text x="776.5" y="68.7" text-anchor="end">😵 どれが何の音かわからない</text></g>
<text x="16" y="175.0" class="axt" transform="rotate(-90 16 175.0)" text-anchor="middle">SE登録数（件・累計）</text>
<text x="986" y="175.0" class="axt" transform="rotate(90 986 175.0)" text-anchor="middle">はなこの困り度</text>
</svg></div>
                </div>
                <p class="fineprint">※ グラフはイメージです。データは存在せず、はなこの困り度も目分量です。</p>
                <div class="hero-actions" style="justify-content: center; margin-top: 26px">
                    <a class="btn btn-ghost" href="#se">SEの使い方を見る →</a>
                </div>
            </div>
        </section>

<style>
    /* 複合グラフ */
    .chart-card {
        padding: 28px 28px 18px;
        overflow: visible;
    }

    .chart-card:hover {
        transform: none;
    }

    .chart-mascot {
        position: absolute;
        top: -34px;
        right: 22px;
        width: 96px;
        filter: drop-shadow(0 8px 14px rgba(214, 51, 111, 0.25));
        pointer-events: none;
    }

    .chart-top {
        padding-right: 110px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
    }

    .chart-top b {
        display: block;
        font-size: 17px;
    }

    .chart-top small {
        color: var(--text-dim);
        font-size: 12px;
    }

    .chart-legend {
        display: flex;
        gap: 18px;
        font-size: 13px;
        color: var(--text-muted);
    }

    .chart-legend i {
        display: inline-block;
        vertical-align: middle;
        margin-right: 6px;
    }

    .lg-bar {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: linear-gradient(#ff9cc2, #ffd3e3);
    }

    .lg-line {
        width: 20px;
        height: 3px;
        border-radius: 2px;
        background: linear-gradient(90deg, #3cc0b5, #d6336f);
    }

    .chart-kpis {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 10px;
    }

    .chart-kpis div {
        padding: 12px 16px;
        border-radius: 18px;
        background: var(--pink-pale);
        border: 2px dashed var(--pink-soft);
    }

    .chart-kpis b {
        display: block;
        font-size: 24px;
        font-weight: 900;
    }

    .chart-kpis small {
        color: var(--text-muted);
        font-size: 12px;
    }

    .chart-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .combo-chart {
        width: 100%;
        height: auto;
        display: block;
        overflow: visible;
    }

    .combo-chart .grid {
        stroke: rgba(74, 54, 64, 0.08);
    }

    .combo-chart text {
        font-family: var(--mono);
        font-size: 12px;
        fill: var(--text-dim);
    }

    .combo-chart .axl {
        fill: #c2457a;
    }

    .combo-chart .axr {
        fill: var(--mint-ink);
    }

    .combo-chart .axt {
        font-family: var(--font);
        font-size: 12px;
        fill: var(--text-muted);
    }

    .combo-chart .limit {
        stroke: var(--red);
        stroke-width: 1.5;
        stroke-dasharray: 6 5;
    }

    .combo-chart .limit-label {
        fill: var(--red);
        font-family: var(--font);
        font-weight: 700;
    }

    .combo-chart .cdot {
        fill: #fff;
        stroke: var(--pink-ink);
        stroke-width: 2.5;
    }

    .combo-chart .annot line {
        stroke: rgba(74, 54, 64, 0.35);
        stroke-dasharray: 3 3;
    }

    .combo-chart .annot text {
        font-family: var(--font);
        fill: var(--text);
        font-size: 13px;
        font-weight: 700;
    }

    /* スクロールで表示されたら（.in が付いたら）線を引き、棒を伸ばす */
    .combo-chart .cline {
        stroke-dasharray: 2000;
        stroke-dashoffset: 2000;
        transition: stroke-dashoffset 2.2s ease;
    }

    .chart-card.in .cline {
        stroke-dashoffset: 0;
    }

    .combo-chart .cbar {
        transform-box: fill-box;
        transform-origin: bottom;
        transform: scaleY(0);
        transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
        transition-delay: var(--d);
    }

    .chart-card.in .cbar {
        transform: scaleY(1);
    }

    @media (max-width: 640px) {
        .chart-kpis {
            grid-template-columns: 1fr;
        }
        .chart-card {
            padding: 20px 14px 12px;
        }
        .chart-scroll .combo-chart {
            min-width: 680px;
        }
        .chart-top {
            padding-right: 70px;
        }
        .chart-mascot {
            width: 64px;
            top: -24px;
            right: 12px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .combo-chart .cline {
            stroke-dashoffset: 0;
        }
        .combo-chart .cbar {
            transform: none;
        }
    }
</style>
