<script>
    // AI に貼り付けると、はなこになりきって導入を手伝ってくれるプロンプトをコピーする
    // サイト上には中身を表示しない。表示した文章とコピーされる文章が同じだと利用者には確かめようがないので、
    // 貼り付けた先（AI のチャット欄）で読んでもらう
    import aiSetupPrompt from '../../data/ai-setup-prompt.txt?raw';

    const copyButton = document.getElementById('ai-prompt-copy')!;
    const status = document.getElementById('ai-prompt-status')!;
    let resetTimer: number | undefined;

    const showStatus = (message: string) => {
        status.textContent = message;
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => (status.textContent = ''), 4000);
    };

    // Clipboard API が使えないブラウザ向けに、画面外のテキストエリアから従来の方法でコピーする
    const copyWithTextarea = (text: string) => {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        return copied;
    };

    copyButton.addEventListener('click', async () => {
        let copied = false;
        try {
            await navigator.clipboard.writeText(aiSetupPrompt);
            copied = true;
        } catch {
            copied = copyWithTextarea(aiSetupPrompt);
        }
        showStatus(
            copied
                ? '✅ コピーしました！ AI のチャット欄に貼り付けて、送る前に読んでね'
                : 'ごめんね、このブラウザではコピーできなかったにゃ…',
        );
    });
</script>

