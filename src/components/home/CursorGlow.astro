<div class="cursor-glow" aria-hidden="true"></div>

<script>
    // カーソルについてくる、ほんのり桃色の光
    const glow = document.querySelector<HTMLElement>('.cursor-glow')!;
    window.addEventListener('pointermove', (e) => {
        glow.style.left = e.clientX + 'px';
        glow.style.top = e.clientY + 'px';
    });
</script>

<style>
    .cursor-glow {
        position: fixed;
        z-index: -1;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 168, 203, 0.22), transparent 60%);
        transform: translate(-50%, -50%);
        pointer-events: none;
        left: -999px;
        top: -999px;
    }
</style>
