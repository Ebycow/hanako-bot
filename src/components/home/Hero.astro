---
import { limits, fmt } from '../../data/limits';
import { allCommands } from '../../data/commands';
import HeroPetals from './HeroPetals.astro';
---

<section class="hero" aria-labelledby="hero-title">
    <HeroPetals />
    <div class="container hero-layout">
        <div class="hero-copy">
            <span class="pill"><b>NEW</b> 🚀 Next-Gen Text-to-Speech for Discord</span>
            <h1 id="hero-title">
                あなたの言葉に、<br /><span class="hl">「声」という花を。</span>
            </h1>
            <p class="lead">
                Hanakoは、Discordのチャットを<strong>リアルタイム</strong>で音声に変換する、次世代の読み上げソリューションです。<br />
                <span class="typing" id="typing" aria-live="polite">シームレスに。</span>
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#invite">無料で始める ✨</a>
                <a class="btn btn-ghost" href="#commands">▶ コマンドを見る</a>
            </div>
            <div class="hero-trust">
                <div class="avatars" aria-hidden="true">
                    <img src="assets/hanako-cheer.webp" alt="" />
                    <img src="assets/hanako-wave.webp" alt="" />
                    <img src="assets/hanako-icon.webp" alt="" />
                    <img src="assets/hanako-hello.webp" alt="" />
                </div>
                <div>
                    <span class="stars" aria-hidden="true">★★★★★</span><br />
                    クレジットカード不要・完全無料
                </div>
            </div>
        </div>
        <div class="hero-art">
            <div class="hero-ring" aria-hidden="true"></div>
            <div class="hero-card">
                <div class="hero-card-inner">
                    <img src="assets/hanako-hero.webp" alt="Discordのマスコットを抱きしめてヘッドセットで話す花子。桃色の髪と猫耳、白い制服が特徴のキャラクター" />
                </div>
            </div>
            <div class="float-chip chip-a" aria-hidden="true">
                <span class="ico">🗣️</span>
                <span><small>Voice Engine</small><strong>読み上げ中…</strong></span>
            </div>
            <div class="float-chip chip-b" aria-hidden="true">
                <span class="ico">📚</span>
                <span><small>Dictionary</small><strong>+1 単語を学習</strong></span>
            </div>
            <div class="float-chip chip-c" aria-hidden="true">
                <span class="ico">🎺</span>
                <span><small>SE Engine</small><strong>「（拍手）」を追加</strong></span>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="stats reveal">
            <div class="stat"><b class="hl" data-count={allCommands.length}>{allCommands.length}</b><span>のコマンドを搭載</span></div>
            <div class="stat"><b class="hl" data-count={limits.dictionaryEntries}>{fmt(limits.dictionaryEntries)}</b><span>語の辞書をサーバーごとに</span></div>
            <div class="stat"><b class="hl" data-count={limits.seEntries}>{fmt(limits.seEntries)}</b><span>件のSEを登録可能</span></div>
            <div class="stat"><b class="hl">¥0</b><span>どこまでも無料</span></div>
        </div>
    </div>
</section>

<script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 数字のカウントアップ
    if ('IntersectionObserver' in window && !reduceMotion) {
        const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const end = Number(el.dataset.count);
                const start = performance.now();
                io.unobserve(el);
                const tick = (now: number) => {
                    const t = Math.min((now - start) / 1600, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    el.textContent = Math.round(end * eased).toLocaleString();
                    if (t < 1) requestAnimationFrame(tick);
                };
                tick(start);
            });
        });
        document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
    }

    // ヒーローのタイピング演出
    if (!reduceMotion) {
        const el = document.getElementById('typing')!;
        const words = ['シームレスに。', '直感的に。', 'パワフルに。', 'インクルーシブに。', '次のレベルへ。'];
        let i = 0;
        let pos = words[0].length;
        let deleting = true;
        const step = () => {
            const word = words[i];
            pos += deleting ? -1 : 1;
            el.textContent = word.slice(0, pos);
            let delay = deleting ? 45 : 110;
            if (!deleting && pos === word.length) {
                deleting = true;
                delay = 1800;
            } else if (deleting && pos === 0) {
                deleting = false;
                i = (i + 1) % words.length;
                delay = 300;
            }
            setTimeout(step, delay);
        };
        setTimeout(step, 1800);
    }
</script>

<style>
    .hero {
        position: relative;
        padding: 80px 0 60px;
    }

    .hero > .container {
        position: relative;
        z-index: 1;
    }

    .hero-layout {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 48px;
        align-items: center;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 16px 4px 5px;
        border-radius: 999px;
        border: 2px solid var(--pink-soft);
        background: var(--surface);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-muted);
    }

    .pill b {
        padding: 1px 10px;
        border-radius: 999px;
        background: var(--pink-ink);
        color: #fff;
        font-size: 11px;
        letter-spacing: 0.06em;
    }

    .hero h1 {
        font-size: clamp(36px, 5.6vw, 66px);
        line-height: 1.3;
        letter-spacing: 0.01em;
        margin: 22px 0 22px;
    }

    .hero .lead {
        font-size: 18px;
        color: var(--text-muted);
        max-width: 580px;
        margin: 0 0 32px;
    }

    .typing {
        display: inline-block;
        min-width: 1ch;
        color: var(--pink-ink);
        font-weight: 900;
        border-right: 3px solid var(--pink);
        padding-right: 4px;
        animation: caret 1s steps(1) infinite;
    }

    @keyframes caret {
        50% {
            border-color: transparent;
        }
    }

    .hero-trust {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 34px;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 700;
    }

    .avatars {
        display: flex;
    }

    .avatars img {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        object-position: top;
        border: 3px solid #fff;
        background: var(--pink-pale);
        box-shadow: 0 0 0 2px var(--pink-soft);
        margin-left: -10px;
    }

    .avatars img:first-child {
        margin-left: 0;
    }

    .stars {
        color: #ffb84d;
        letter-spacing: 2px;
    }

    /* 右側のイラスト：桃色のまるいふきだしの上にはなこを乗せる */
    .hero-art {
        position: relative;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
    }

    /* 点線の輪がゆっくり回る */
    .hero-ring {
        position: absolute;
        inset: 1%;
        border-radius: 50%;
        border: 3px dashed var(--pink-soft);
        animation: spin 40s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .hero-card {
        position: relative;
        width: 88%;
        aspect-ratio: 1;
    }

    .hero-card::before {
        content: '';
        position: absolute;
        inset: 6%;
        border-radius: 46% 54% 50% 50% / 52% 46% 54% 48%;
        background: radial-gradient(circle at 35% 30%, #fff 0%, var(--pink-pale) 38%, var(--pink-soft) 100%);
        box-shadow:
            0 0 0 10px rgba(255, 255, 255, 0.85),
            0 0 0 12px var(--pink-soft),
            var(--soft-shadow);
        animation: blob 9s ease-in-out infinite alternate;
    }

    @keyframes blob {
        to {
            border-radius: 54% 46% 46% 54% / 46% 54% 46% 54%;
        }
    }

    .hero-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        display: grid;
        place-items: end center;
    }

    .hero-card-inner img {
        height: 100%;
        width: auto;
        max-width: 96%;
        object-fit: contain;
        display: block;
        filter: drop-shadow(0 14px 24px rgba(214, 51, 111, 0.22));
    }

    .float-chip {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 16px 8px 8px;
        border-radius: 22px;
        background: var(--surface);
        border: 2px solid var(--border);
        font-size: 13px;
        box-shadow: var(--pop);
        animation: bob 5s ease-in-out infinite;
        white-space: nowrap;
    }

    .float-chip small {
        display: block;
        color: var(--text-dim);
        font-size: 11px;
        line-height: 1.3;
    }

    .float-chip strong {
        display: block;
        line-height: 1.4;
        font-weight: 900;
    }

    .float-chip .ico {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--pink-pale);
        font-size: 17px;
    }

    .chip-a {
        top: 8%;
        left: -6%;
    }

    .chip-b {
        bottom: 16%;
        right: -8%;
        animation-delay: -2.5s;
    }

    .chip-b .ico {
        background: var(--mint-soft);
    }

    .chip-c {
        bottom: 2%;
        left: 0;
        animation-delay: -1.2s;
    }

    .chip-c .ico {
        background: var(--lavender-soft);
    }

    /* 統計 */
    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-top: 70px;
    }

    .stat {
        background: var(--surface);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--pop);
        padding: 24px 20px;
        text-align: center;
    }

    .stat b {
        display: inline-block;
        font-size: clamp(32px, 3.8vw, 46px);
        font-weight: 900;
        line-height: 1.25;
    }

    .stat span {
        display: block;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 700;
    }

    @media (max-width: 960px) {
        .hero-layout {
            grid-template-columns: 1fr;
        }
        .hero-art {
            max-width: 440px;
            margin: 0 auto;
            width: 100%;
        }
        .stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .hero {
            padding-top: 50px;
        }
        .float-chip {
            font-size: 11.5px;
            padding: 6px 12px 6px 6px;
        }
        .float-chip .ico {
            width: 30px;
            height: 30px;
            font-size: 14px;
        }
        .chip-a {
            left: 0;
        }
        .chip-b {
            right: 0;
        }
    }
</style>
