---
import Img from '../Img.astro';
import { limits, fmt } from '../../data/limits';
import { allCommands } from '../../data/commands';
import HeroPetals from './HeroPetals.astro';

// ヒーローのタイピング演出で、順に打ち込む文
const phrases = ['マイクがなくても会話に入れます。', '聞き専でもチャットがわかります。', '内輪の呼び名も辞書で読めます。', 'キーワードで効果音が鳴ります。', '長い読み上げは成敗で止められます。'];
---

<section class="hero" aria-labelledby="hero-title">
    <HeroPetals />
    <div class="container hero-layout">
        <div class="hero-copy">
            <span class="pill"><b>Discord</b>読み上げBot</span>
            <h1 id="hero-title">
                Discordのチャットを、<br /><span class="hl">はなこが読み上げます。</span>
            </h1>
            <p class="lead">
                Hanakoは、テキストチャットの発言を<strong>その場で</strong>ボイスチャンネルに読み上げるBotです。<br />
                {/* 打っては消す文字は読み上げソフトに1文字ずつ読まれるので隠し、同じ内容をまとめて渡す */}
                <span class="typing" id="typing" aria-hidden="true" data-phrases={JSON.stringify(phrases)}>{phrases[0]}</span>
                <span class="sr-only">{phrases.join('')}</span>
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#invite">はなこに会うには？</a>
                <a class="btn btn-ghost" href="docs.html#commands">コマンドを見る</a>
            </div>
            <div class="hero-trust">
                <div class="avatars" aria-hidden="true">
                    <Img src="hanako-cheer.webp" alt="" width={38} loading="eager" />
                    <Img src="hanako-wave.webp" alt="" width={38} loading="eager" />
                    <Img src="hanako-icon.webp" alt="" width={38} loading="eager" />
                    <Img src="hanako-hello.webp" alt="" width={38} loading="eager" />
                </div>
                <div>料金はかかりません</div>
            </div>
        </div>
        <div class="hero-art">
            <div class="hero-ring" aria-hidden="true"></div>
            <div class="hero-card">
                <div class="hero-card-inner">
                    <Img src="hanako-hero.webp" alt="Discordのマスコットを抱きしめてヘッドセットで話すはなこ。桃色の髪と猫耳、白い制服が特徴のキャラクター" width={420} loading="eager" fetchpriority="high" />
                </div>
            </div>
            <div class="float-chip chip-a" aria-hidden="true">
                <span class="ico">🗣️</span>
                <span><small>はなこ</small><strong>読み上げ中…</strong></span>
            </div>
            <div class="float-chip chip-b" aria-hidden="true">
                <span class="ico">📚</span>
                <span><small>辞書</small><strong>単語を1つ覚えました</strong></span>
            </div>
            <div class="float-chip chip-c" aria-hidden="true">
                <span class="ico">🎺</span>
                <span><small>SE</small><strong>（拍手）を追加</strong></span>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="stats reveal">
            <div class="stat"><b class="hl" data-count={allCommands.length}>{allCommands.length}</b><span>種類のコマンド</span></div>
            <div class="stat"><b class="hl" data-count={limits.dictionaryEntries}>{fmt(limits.dictionaryEntries)}</b><span>語まで辞書へ登録できます</span></div>
            <div class="stat"><b class="hl" data-count={limits.seEntries}>{fmt(limits.seEntries)}</b><span>件までSEを登録できます</span></div>
            <div class="stat"><b class="hl">¥0</b><span>料金はかかりません</span></div>
        </div>
    </div>
</section>

<script>
    import { isMotionOff, onMotionChange } from '../../scripts/motion';

    // 数字のカウントアップ（動きを止めているときは、最初から最終の数字を見せる）
    if ('IntersectionObserver' in window && !isMotionOff()) {
        const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const end = Number(el.dataset.count);
                const start = performance.now();
                io.unobserve(el);
                const tick = (now: number) => {
                    const t = Math.min((now - start) / 1600, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    el.textContent = Math.round(end * eased).toLocaleString();
                    if (t < 1) requestAnimationFrame(tick);
                };
                tick(start);
            });
        });
        document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
    }

    // ヒーローのタイピング演出。動きを止めたら、打ちかけの文を最後まで出して止まる
    {
        const el = document.getElementById('typing')!;
        const words: string[] = JSON.parse(el.dataset.phrases!);
        let i = 0;
        let pos = words[0].length;
        let deleting = true;
        let timer: number | undefined;
        const step = () => {
            const word = words[i];
            pos += deleting ? -1 : 1;
            el.textContent = word.slice(0, pos);
            let delay = deleting ? 45 : 110;
            if (!deleting && pos === word.length) {
                deleting = true;
                delay = 1800;
            } else if (deleting && pos === 0) {
                deleting = false;
                i = (i + 1) % words.length;
                delay = 300;
            }
            timer = window.setTimeout(step, delay);
        };
        const start = () => (timer = window.setTimeout(step, 1800));
        const stop = () => {
            clearTimeout(timer);
            if (pos === 0) i = (i + 1) % words.length;
            el.textContent = words[i];
            pos = words[i].length;
            deleting = true;
        };
        if (!isMotionOff()) start();
        onMotionChange((off) => (off ? stop() : start()));
    }
</script>

<style>
    .hero {
        position: relative;
        padding: 80px 0 60px;
    }

    .hero > .container {
        position: relative;
        z-index: 1;
    }

    .hero-layout {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 48px;
        align-items: center;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 16px 4px 5px;
        border-radius: var(--radius-pill);
        border: 2px solid var(--pink-soft);
        background: var(--surface);
        font-size: var(--fs-sm);
        font-weight: 700;
        color: var(--text-muted);
    }

    .pill b {
        padding: 1px 10px;
        border-radius: var(--radius-pill);
        background: var(--pink-ink);
        color: var(--on-accent);
        font-size: var(--fs-xs);
        letter-spacing: 0.06em;
    }

    .hero h1 {
        font-size: var(--fs-display);
        line-height: 1.3;
        letter-spacing: 0.01em;
        margin: 22px 0 22px;
    }

    .hero .lead {
        font-size: var(--fs-lg);
        color: var(--text-muted);
        max-width: 580px;
        margin: 0 0 32px;
    }

    .typing {
        display: inline-block;
        min-width: 1ch;
        color: var(--pink-ink);
        font-weight: 900;
        position: relative;
        padding-right: 7px;
    }

    /* カーソルは疑似要素の opacity で点滅させる（border-color だと毎回再描画になる） */
    .typing::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 3px;
        background: var(--pink);
        animation: caret 1s steps(1) infinite;
    }

    @keyframes caret {
        50% {
            opacity: 0;
        }
    }

    .hero-trust {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 34px;
        color: var(--text-muted);
        font-size: var(--fs-md);
        font-weight: 700;
    }

    .avatars {
        display: flex;
    }

    .avatars img {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        object-position: top;
        border: 3px solid var(--surface);
        background: var(--pink-pale);
        box-shadow: 0 0 0 2px var(--pink-soft);
        margin-left: -10px;
    }

    .avatars img:first-child {
        margin-left: 0;
    }

    /* 右側のイラスト：桃色のまるいふきだしの上にはなこを乗せる */
    .hero-art {
        position: relative;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
    }

    /* 点線の輪が、読み込んだときに少し回って止まる（飾りの動きは5秒以内で止める） */
    .hero-ring {
        position: absolute;
        inset: 1%;
        border-radius: 50%;
        border: 3px dashed var(--pink-soft);
        animation: ring-in 5s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @keyframes ring-in {
        from {
            transform: rotate(-90deg);
        }
    }

    .hero-card {
        position: relative;
        width: 88%;
        aspect-ratio: 1;
    }

    .hero-card::before {
        content: '';
        position: absolute;
        inset: 6%;
        border-radius: 46% 54% 50% 50% / 52% 46% 54% 48%;
        background: radial-gradient(circle at 35% 30%, var(--surface) 0%, var(--pink-pale) 38%, var(--pink-soft) 100%);
        box-shadow:
            0 0 0 10px rgba(255, 255, 255, 0.85),
            0 0 0 12px var(--pink-soft),
            var(--soft-shadow);
        animation: blob 5s ease-in-out forwards;
    }

    @keyframes blob {
        to {
            border-radius: 54% 46% 46% 54% / 46% 54% 46% 54%;
        }
    }

    .hero-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        display: grid;
        place-items: end center;
    }

    .hero-card-inner img {
        height: 100%;
        width: auto;
        max-width: 96%;
        object-fit: contain;
        display: block;
        filter: drop-shadow(0 14px 24px rgb(var(--shadow-rgb) / 0.22));
    }

    .float-chip {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 16px 8px 8px;
        border-radius: var(--radius);
        background: var(--surface);
        border: 2px solid var(--border);
        font-size: var(--fs-sm);
        box-shadow: var(--pop);
        animation: bob 5s ease-in-out;
        white-space: nowrap;
    }

    .float-chip small {
        display: block;
        color: var(--text-dim);
        font-size: var(--fs-xs);
        line-height: 1.3;
    }

    .float-chip strong {
        display: block;
        line-height: 1.4;
        font-weight: 900;
    }

    .float-chip .ico {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--pink-pale);
        font-size: var(--fs-lg);
    }

    .chip-a {
        top: 8%;
        left: -6%;
    }

    .chip-b {
        bottom: 16%;
        right: -8%;
        animation-delay: -2.5s;
    }

    .chip-b .ico {
        background: var(--mint-soft);
    }

    .chip-c {
        bottom: 2%;
        left: 0;
        animation-delay: -1.2s;
    }

    .chip-c .ico {
        background: var(--lavender-soft);
    }

    /* 統計 */
    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-top: 70px;
    }

    .stat {
        background: var(--surface);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--pop);
        padding: 24px 20px;
        text-align: center;
    }

    .stat b {
        display: inline-block;
        font-size: var(--fs-h2);
        font-weight: 900;
        line-height: 1.25;
    }

    .stat span {
        display: block;
        color: var(--text-muted);
        font-size: var(--fs-md);
        font-weight: 700;
    }

    @media (max-width: 960px) {
        .hero-layout {
            grid-template-columns: 1fr;
        }
        .hero-art {
            max-width: 440px;
            margin: 0 auto;
            width: 100%;
        }
        .stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .hero {
            padding-top: 50px;
        }
        .float-chip {
            font-size: var(--fs-xs);
            padding: 6px 12px 6px 6px;
        }
        .float-chip .ico {
            width: 30px;
            height: 30px;
            font-size: var(--fs-md);
        }
        .chip-a {
            left: 0;
        }
        .chip-b {
            right: 0;
        }
    }
</style>
