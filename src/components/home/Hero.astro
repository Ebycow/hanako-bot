---
import { limits, fmt } from '../../data/limits';
import { allCommands } from '../../data/commands';
import HeroPetals from './HeroPetals.astro';
---

<section class="hero" aria-labelledby="hero-title">
    <HeroPetals />
    <div class="container hero-layout">
        <div class="hero-copy">
            <span class="pill"><b>NEW</b> 🚀 Next-Gen Text-to-Speech for Discord</span>
            <h1 id="hero-title">
                あなたの言葉に、<br /><span class="gradient-text">「声」という花を。</span>
            </h1>
            <p class="lead">
                Hanakoは、Discordのチャットを<strong>リアルタイム</strong>で音声に変換する、次世代の読み上げソリューションです。<br />
                <span class="typing" id="typing" aria-live="polite">シームレスに。</span>
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#invite">無料で始める ✨</a>
                <a class="btn btn-ghost" href="#commands">▶ コマンドを見る</a>
            </div>
            <div class="hero-trust">
                <div class="avatars" aria-hidden="true">
                    <img src="assets/hanako-cheer.webp" alt="" />
                    <img src="assets/hanako-wave.webp" alt="" />
                    <img src="assets/hanako-icon.webp" alt="" />
                    <img src="assets/hanako-hello.webp" alt="" />
                </div>
                <div>
                    <span class="stars" aria-hidden="true">★★★★★</span><br />
                    クレジットカード不要・完全無料
                </div>
            </div>
        </div>
        <div class="hero-art">
            <div class="hero-ring" aria-hidden="true"></div>
            <div class="hero-card">
                <div class="hero-card-inner">
                    <img src="assets/hanako-hero.webp" alt="Discordのマスコットを抱きしめてヘッドセットで話す花子。桃色の髪と猫耳、白い制服が特徴のキャラクター" />
                </div>
            </div>
            <div class="float-chip chip-a" aria-hidden="true">
                <span class="ico">🗣️</span>
                <span><small>Voice Engine</small><strong>読み上げ中…</strong></span>
            </div>
            <div class="float-chip chip-b" aria-hidden="true">
                <span class="ico">📚</span>
                <span><small>Dictionary</small><strong>+1 単語を学習</strong></span>
            </div>
            <div class="float-chip chip-c" aria-hidden="true">
                <span class="ico">🎺</span>
                <span><small>SE Engine</small><strong>「（拍手）」を追加</strong></span>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="stats reveal">
            <div class="stat"><b class="gradient-text" data-count={allCommands.length}>{allCommands.length}</b><span>のコマンドを搭載</span></div>
            <div class="stat"><b class="gradient-text" data-count={limits.dictionaryEntries}>{fmt(limits.dictionaryEntries)}</b><span>語の辞書をサーバーごとに</span></div>
            <div class="stat"><b class="gradient-text" data-count={limits.seEntries}>{fmt(limits.seEntries)}</b><span>件のSEを登録可能</span></div>
            <div class="stat"><b class="gradient-text">¥0</b><span>どこまでも無料</span></div>
        </div>
    </div>
</section>

<script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 数字のカウントアップ
    if ('IntersectionObserver' in window && !reduceMotion) {
        const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const end = Number(el.dataset.count);
                const start = performance.now();
                io.unobserve(el);
                const tick = (now: number) => {
                    const t = Math.min((now - start) / 1600, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    el.textContent = Math.round(end * eased).toLocaleString();
                    if (t < 1) requestAnimationFrame(tick);
                };
                tick(start);
            });
        });
        document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
    }

    // ヒーローのタイピング演出
    if (!reduceMotion) {
        const el = document.getElementById('typing')!;
        const words = ['シームレスに。', '直感的に。', 'パワフルに。', 'インクルーシブに。', '次のレベルへ。'];
        let i = 0;
        let pos = words[0].length;
        let deleting = true;
        const step = () => {
            const word = words[i];
            pos += deleting ? -1 : 1;
            el.textContent = word.slice(0, pos);
            let delay = deleting ? 45 : 110;
            if (!deleting && pos === word.length) {
                deleting = true;
                delay = 1800;
            } else if (deleting && pos === 0) {
                deleting = false;
                i = (i + 1) % words.length;
                delay = 300;
            }
            setTimeout(step, delay);
        };
        setTimeout(step, 1800);
    }
</script>

<style>
    .hero {
        position: relative;
        padding: 90px 0 60px;
    }

    .hero > .container {
        position: relative;
        z-index: 1;
    }

    .hero-layout {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 48px;
        align-items: center;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px 6px 6px;
        border-radius: 999px;
        border: 1px solid rgba(139, 92, 246, 0.35);
        background: rgba(139, 92, 246, 0.1);
        font-size: 13px;
        color: #d6ccff;
    }

    .pill b {
        padding: 2px 9px;
        border-radius: 999px;
        background: var(--grad);
        color: #0b0820;
        font-size: 11px;
        letter-spacing: 0.05em;
    }

    .hero h1 {
        font-size: clamp(38px, 6vw, 72px);
        line-height: 1.12;
        letter-spacing: -0.035em;
        font-weight: 800;
        margin: 22px 0 22px;
    }

    .hero .lead {
        font-size: 18.5px;
        color: var(--text-muted);
        max-width: 580px;
        margin: 0 0 32px;
    }

    .typing {
        display: inline-block;
        min-width: 1ch;
        border-right: 3px solid var(--cyan);
        padding-right: 4px;
        animation: caret 1s steps(1) infinite;
    }

    @keyframes caret {
        50% {
            border-color: transparent;
        }
    }

    .hero-trust {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 34px;
        color: var(--text-muted);
        font-size: 14px;
    }

    .avatars {
        display: flex;
    }

    .avatars img {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        object-fit: cover;
        object-position: top;
        border: 2px solid var(--bg);
        background: #1e1b3a;
        margin-left: -10px;
    }

    .avatars img:first-child {
        margin-left: 0;
    }

    .stars {
        color: #fbbf24;
        letter-spacing: 2px;
    }

    /* 右側のイラスト */
    .hero-art {
        position: relative;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
    }

    .hero-ring {
        position: absolute;
        inset: 6%;
        border-radius: 50%;
        background: conic-gradient(from 0deg, #7c3aed, #2563eb, #22d3ee, #ec4899, #7c3aed);
        filter: blur(40px);
        opacity: 0.55;
        animation: spin 14s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .hero-card {
        position: relative;
        width: 86%;
        aspect-ratio: 1;
        border-radius: 36px;
        padding: 1.5px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.04) 40%, rgba(139, 92, 246, 0.5));
    }

    .hero-card-inner {
        width: 100%;
        height: 100%;
        border-radius: 35px;
        background: rgba(13, 11, 29, 0.72);
        backdrop-filter: blur(20px);
        display: grid;
        place-items: end center;
        overflow: hidden;
    }

    .hero-card-inner img {
        height: 96%;
        width: auto;
        max-width: 92%;
        object-fit: contain;
        display: block;
        filter: drop-shadow(0 20px 40px rgba(124, 58, 237, 0.5));
    }

    .float-chip {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        border-radius: 16px;
        background: rgba(20, 17, 42, 0.78);
        border: 1px solid var(--border-strong);
        backdrop-filter: blur(14px);
        font-size: 13px;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6);
        animation: bob 5s ease-in-out infinite;
        white-space: nowrap;
    }

    .float-chip small {
        display: block;
        color: var(--text-muted);
        font-size: 11px;
        line-height: 1.3;
    }

    .float-chip strong {
        display: block;
        line-height: 1.3;
    }

    .float-chip .ico {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--grad);
        font-size: 16px;
    }

    .chip-a {
        top: 8%;
        left: -6%;
    }

    .chip-b {
        bottom: 14%;
        right: -8%;
        animation-delay: -2.5s;
    }

    .chip-c {
        bottom: 2%;
        left: 2%;
        animation-delay: -1.2s;
    }

    /* 統計 */
    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin-top: 70px;
    }

    .stat {
        background: rgba(13, 11, 29, 0.85);
        padding: 30px 24px;
        text-align: center;
    }

    .stat b {
        display: block;
        font-size: clamp(34px, 4vw, 48px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .stat span {
        color: var(--text-muted);
        font-size: 14px;
    }

    @media (max-width: 960px) {
        .hero-layout {
            grid-template-columns: 1fr;
        }
        .hero-art {
            max-width: 440px;
            margin: 0 auto;
            width: 100%;
        }
        .stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .hero {
            padding-top: 50px;
        }
        .float-chip {
            font-size: 11.5px;
            padding: 8px 12px;
        }
        .chip-a {
            left: 0;
        }
        .chip-b {
            right: 0;
        }
    }
</style>
