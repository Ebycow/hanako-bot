---
import Img from '../Img.astro';
import { limits, fmt } from '../../data/limits';

// マウスを乗せる・タップするたびに、quotes からランダムに1つしゃべる
const expressions = [
    {
        image: 'hanako-cheer.webp',
        alt: 'うれしそうに喜ぶ花子',
        caption: 'うれしい！',
        quotes: [
            `やったー！辞書に${fmt(limits.dictionaryEntries)}件目が登録されたにゃ！`,
            'このサイト、ちょっと盛りすぎじゃない？うれしいけど。',
            'ProプランもEnterpriseプランも¥0だよ。お得でしょ？',
        ],
    },
    {
        image: 'hanako-thinking.webp',
        alt: '考え込む花子',
        caption: '考え中…',
        quotes: [
            '「イか略。」の「イ」がカタカナな理由、実はわたしも知らないの。',
            '>askで聞いてくれたら、はいかいいえで答えるよ。根拠はないけど。',
            '草原を「くさはら」と読むべきか、ずっと考えてる。',
        ],
    },
    {
        image: 'hanako-surprised.webp',
        alt: '驚いた花子',
        caption: 'びっくり',
        quotes: [
            'えっ、わたしの料金プランって3つもあるの！？',
            '「草」ってSE登録したら「草原」でも鳴った！！',
            `${limits.seFileMB}MBを超えるSEは入らないにゃ…！`,
        ],
    },
    {
        image: 'hanako-sleepy.webp',
        alt: '眠そうな花子',
        caption: 'ひとやすみ',
        quotes: ['みんな帰ったから、わたしも帰って寝るね…zzz', '/seibaiされたから、今日はもう休むにゃ…', '長文は、30文字くらいで勘弁して…'],
    },
    {
        image: 'hanako-pointing.webp',
        alt: '下を指さす花子',
        caption: 'こっちだよ',
        quotes: [
            'コマンド一覧は、使い方ガイドのページにあるよ。',
            'その発言、>で始まってるから読まないよ？',
            '招待URLはこっち……じゃなかった、ないんだった。',
        ],
    },
    {
        image: 'hanako-blossom.webp',
        alt: '桜を差し出す花子',
        caption: 'ありがとう ♡',
        quotes: ['「声という花」って、わたしのことかな？えへへ。', '最後まで読んでくれてありがとう ♡', '桜の季節はSEの登録が増えるにゃ。'],
    },
];
---

<section class="section" aria-labelledby="expression-title">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">Meet Hanako</span>
            <h2 id="expression-title">いろんな顔をする、<br /><span class="hl">はなこです。</span></h2>
        </div>
        <p class="fineprint" style="margin: -30px 0 90px">マウスを乗せると、はなこが何か言います。スマホはタップしてください</p>
        <div class="expression-grid">
            {
                expressions.map((e) => (
                    <figure class="card reveal says" tabindex="0" data-quotes={JSON.stringify(e.quotes)}>
                        <span class="speech" aria-live="polite" />
                        <Img src={e.image} alt={e.alt} width={160} />
                        <figcaption>{e.caption}</figcaption>
                    </figure>
                ))
            }
        </div>
    </div>
</section>

<script>
    // 表情ギャラリーのセリフ
    document.querySelectorAll<HTMLElement>('.says').forEach((fig) => {
        const quotes: string[] = JSON.parse(fig.dataset.quotes!);
        const speech = fig.querySelector('.speech')!;
        let last = -1;
        const talk = () => {
            let i;
            do {
                i = Math.floor(Math.random() * quotes.length);
            } while (quotes.length > 1 && i === last);
            last = i;
            speech.textContent = quotes[i];
        };
        talk();
        fig.addEventListener('mouseenter', talk);
        fig.addEventListener('focus', talk);
        fig.addEventListener('click', talk);
    });
</script>

<style>
    .expression-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .expression-grid figure {
        margin: 0;
        padding: 14px 10px 12px;
        text-align: center;
    }

    .expression-grid img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: contain;
    }

    .expression-grid figure:nth-child(odd) {
        rotate: -1.5deg;
    }

    .expression-grid figure:nth-child(even) {
        rotate: 1.5deg;
    }

    .expression-grid figcaption {
        font-size: var(--fs-sm);
        font-weight: 900;
        color: var(--pink-ink);
    }

    /* 吹き出し */
    .says {
        cursor: pointer;
        overflow: visible;
        outline: none;
    }

    .says:focus-visible {
        outline: 3px solid var(--pink-ink);
        outline-offset: 3px;
    }

    .speech {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 12px);
        z-index: 5;
        width: max-content;
        max-width: 220px;
        padding: 10px 14px;
        border-radius: var(--radius-md);
        background: var(--surface);
        border: 2px solid var(--pink-soft);
        color: var(--text);
        font-size: var(--fs-sm);
        font-weight: 700;
        line-height: 1.6;
        text-align: left;
        box-shadow: 0 4px 0 var(--pink-soft);
        opacity: 0;
        transform: translate(-50%, 8px) scale(0.92);
        transition:
            opacity 0.2s,
            transform 0.2s;
        pointer-events: none;
    }

    .speech::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 100%;
        width: 14px;
        height: 14px;
        margin: -7px 0 0 -7px;
        background: var(--surface);
        border: solid var(--pink-soft);
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .says:hover .speech,
    .says:focus .speech {
        opacity: 1;
        transform: translate(-50%, 0) scale(1);
    }

    .says:hover img,
    .says:focus img {
        animation: wiggle 0.5s ease-in-out;
    }

    @keyframes wiggle {
        25% {
            transform: rotate(-4deg);
        }
        75% {
            transform: rotate(4deg);
        }
    }

    @media (max-width: 960px) {
        .expression-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 640px) {
        .speech {
            max-width: 160px;
            font-size: var(--fs-xs);
        }
    }
</style>
