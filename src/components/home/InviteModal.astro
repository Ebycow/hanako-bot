---
import Img from '../Img.astro';
---

<dialog class="invite-modal" id="invite-modal" aria-labelledby="invite-title">
    <button class="modal-close" type="button" aria-label="閉じる" data-close>✕</button>
    <Img class="invite-art" src="hanako-flappy.webp" alt="招待URLを抱えて飛んでいくはなこ" width={420} />
    <span class="eyebrow">Invitation</span>
    <h2 id="invite-title">はなこは、<span class="hl">恥ずかしがり屋です。</span></h2>
    <p class="invite-lead">
        はなこは誰でも招待できる公開Botですが、とってもシャイなので、<strong>招待URLを抱えてどこかへ飛んでいってしまいました。</strong>このページには招待リンクがありません。はなことは、Discordの中で出会ってください。
    </p>
    <div class="invite-options">
        <div class="card">
            <div class="icon-box">🤝</div>
            <b>Discordで出会ったら、連れて帰ってOK</b>
            <span>はなこがいるサーバーなら、ボイスチャンネルで<code>/plz</code>と呼ぶだけで使えます。気に入ったら、Discord上のはなこのプロフィールから、あなたのサーバーにも招待してあげてください。</span>
        </div>
        <div class="card">
            <div class="icon-box">🛠️</div>
            <b>自分でホストする（おすすめ）</b>
            <span>
                ソースコードはGitHubで公開しています。自分でホストできる方は、ぜひご自身の環境で動かしてください。そのほうが確実です。ただし、読み上げ用の音声サーバーは別に用意する必要があり、手順はREADMEに書いてあります。自分でホストしたBotは、あなた自身が運営者になるので、このサイトの利用規約とプライバシーポリシーは適用されません。
            </span>
        </div>
    </div>
    <div class="hero-actions center">
        <a class="btn btn-primary" href="https://github.com/Ebycow/hanako" target="_blank" rel="noopener">GitHubでソースを見る ↗</a>
        <a class="btn btn-ghost" href="developers.html#self-host">自分でホストする方法</a>
        <a class="btn btn-ghost" href="docs.html#start" data-close>使い方を読む</a>
    </div>
</dialog>

<script>
    // 招待URLポップアップ（URLは恥ずかしがって隠れている）
    const modal = document.getElementById('invite-modal') as HTMLDialogElement;
    const open = () => {
        if (!modal.open) modal.showModal();
    };
    document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a[href="#invite"]');
        if (!a) return;
        e.preventDefault();
        open();
    });
    modal.addEventListener('click', (e) => {
        // 背景クリック、または閉じるボタン・リンクで閉じる
        if (e.target === modal || (e.target as Element).closest('[data-close]')) modal.close();
    });
    // 他ページから ./#invite で来たとき
    if (location.hash === '#invite') {
        history.replaceState(null, '', location.pathname);
        open();
    }
</script>

<style>
    .invite-modal {
        width: min(760px, calc(100vw - 32px));
        max-height: calc(100vh - 40px);
        padding: 36px 40px 40px;
        border-radius: var(--radius-xl);
        border: 3px solid var(--pink-soft);
        background:
            radial-gradient(ellipse at top, rgb(var(--glow-pink) / 0.45), transparent 60%),
            radial-gradient(ellipse at bottom right, rgb(var(--glow-mint) / 0.6), transparent 60%),
            var(--bg-2);
        color: var(--text);
        text-align: center;
        box-shadow:
            0 8px 0 var(--pink-soft),
            0 40px 80px -20px rgb(var(--shadow-rgb) / 0.4);
    }

    .invite-modal[open] {
        animation: modal-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1.2);
    }

    @keyframes modal-in {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(20px);
        }
    }

    .invite-modal::backdrop {
        background: rgb(var(--glow-pink) / 0.35);
        backdrop-filter: blur(6px);
    }

    .modal-close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid var(--pink-soft);
        background: var(--surface);
        color: var(--pink-ink);
        font-weight: 900;
        cursor: pointer;
        font-size: var(--fs-base);
    }

    .invite-art {
        width: min(420px, 90%);
        display: block;
        margin: -6px auto 4px;
        border-radius: var(--radius);
        /* 開くたびに2回だけはばたく（飾りの動きは5秒以内で止める） */
        animation: flap 2.5s ease-in-out 2;
        mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 55%, transparent 100%);
    }

    @keyframes flap {
        50% {
            transform: translate(12px, -12px) rotate(-2deg);
        }
    }

    .invite-modal h2 {
        font-size: var(--fs-h3);
        line-height: 1.4;
        margin: 0 0 14px;
    }

    .invite-lead {
        color: var(--text-muted);
        font-size: var(--fs-body);
        max-width: 580px;
        margin: 0 auto 24px;
    }

    .invite-lead strong {
        color: var(--pink-ink);
    }

    .invite-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        text-align: left;
        margin-bottom: 26px;
    }

    .invite-options .card {
        padding: 22px;
    }

    .invite-options .card:hover {
        transform: none;
    }

    .invite-options b {
        display: block;
        margin-bottom: 6px;
    }

    .invite-options span {
        color: var(--text-muted);
        font-size: var(--fs-md);
    }

    @media (max-width: 960px) {
        .invite-options {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .invite-modal {
            padding: 28px 20px 24px;
        }
    }
</style>
