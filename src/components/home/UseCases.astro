---
const scenes = ['🎮 ゲーム実況', '🌙 深夜の雑談', '📖 勉強会', '🎵 作業通話', '🎲 TRPG', '🍜 飯テロ部', '💼 リモート会議', '🐈 猫を愛でる会'];
---

<section class="logos" aria-label="利用シーン">
    <div class="container">
        <p>いろいろな集まりで使えます</p>
        <div class="marquee" aria-hidden="true">
            <!-- 途切れずに流れるよう、同じ並びを2回くり返す -->
            <div class="marquee-track">
                {[...scenes, ...scenes].map((s) => <span>{s}</span>)}
            </div>
        </div>
    </div>
</section>

<style>
    .logos {
        padding: 30px 0 10px;
        text-align: center;
    }

    .logos p {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 700;
        margin: 0 0 18px;
    }

    .marquee {
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    }

    .marquee-track {
        display: flex;
        gap: 14px;
        width: max-content;
        padding: 4px 0 10px;
        animation: marquee 30s linear infinite;
    }

    .marquee-track span {
        color: var(--text-muted);
        font-weight: 700;
        font-size: 16px;
        white-space: nowrap;
        padding: 6px 20px;
        border-radius: 999px;
        background: var(--surface);
        border: 2px solid var(--border);
        box-shadow: 0 3px 0 var(--pink-soft);
    }

    @keyframes marquee {
        to {
            /* 2回くり返した並びの半分（＋すき間の半分）だけ流すと継ぎ目なくつながる */
            transform: translateX(calc(-50% - 7px));
        }
    }
</style>
