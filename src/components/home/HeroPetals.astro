<canvas class="hero-petals" aria-hidden="true"></canvas>

<script>
    // ヒーロー背景の花びら。はなこの髪に合わせた桜色の花びらを降らせる
    const canvas = document.querySelector<HTMLCanvasElement>('.hero-petals')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduceMotion) {
        const ctx = canvas.getContext('2d')!;
        // 色は tokens.css の変数から読む
        const css = getComputedStyle(document.documentElement);
        const token = (name: string) => css.getPropertyValue(name).trim();
        const glow = `rgb(${token('--glow-pink')})`;
        const colors = [glow, token('--pink-bloom'), token('--pink-soft'), glow, token('--pink')];
        const tip = token('--pink-pale');
        const SPRITE = 48;

        // 花びら（先端に切れ込みのある桜型）を色ごとにオフスクリーンへ描いておく
        const sprites = colors.map((color) => {
            const c = document.createElement('canvas');
            c.width = c.height = SPRITE * 2;
            const g = c.getContext('2d')!;
            const s = SPRITE * 0.62;
            g.translate(SPRITE, SPRITE);
            g.beginPath();
            g.moveTo(0, s * 0.55);
            g.bezierCurveTo(-s * 0.62, s * 0.12, -s * 0.58, -s * 0.55, -s * 0.13, -s * 0.62);
            g.lineTo(0, -s * 0.46);
            g.lineTo(s * 0.13, -s * 0.62);
            g.bezierCurveTo(s * 0.58, -s * 0.55, s * 0.62, s * 0.12, 0, s * 0.55);
            g.closePath();
            const fill = g.createLinearGradient(0, s * 0.55, 0, -s * 0.62);
            fill.addColorStop(0, tip);
            fill.addColorStop(0.5, color);
            fill.addColorStop(1, color);
            g.fillStyle = fill;
            g.fill();
            g.lineWidth = 1.5;
            g.strokeStyle = 'rgba(255, 255, 255, 0.7)';
            g.stroke();
            return c;
        });

        type Petal = {
            x: number;
            y: number;
            size: number;
            vy: number;
            sway: number;
            swaySpeed: number;
            phase: number;
            rot: number;
            vrot: number;
            flip: number;
            vflip: number;
            alpha: number;
            sprite: HTMLCanvasElement;
        };

        let w = 0;
        let h = 0;
        let petals: Petal[] = [];

        const spawn = (initial: boolean): Petal => {
            const depth = Math.random(); // 0 = 奥, 1 = 手前
            const size = 14 + depth * 16;
            return {
                x: Math.random() * w,
                y: initial ? Math.random() * h : -size * 2,
                size,
                vy: 18 + depth * 30,
                sway: 14 + Math.random() * 26,
                swaySpeed: 0.4 + Math.random() * 0.6,
                phase: Math.random() * Math.PI * 2,
                rot: Math.random() * Math.PI * 2,
                vrot: (Math.random() - 0.5) * 1.2,
                flip: Math.random() * Math.PI * 2,
                vflip: 1 + Math.random() * 2,
                alpha: 0.35 + depth * 0.45,
                sprite: sprites[Math.floor(Math.random() * sprites.length)],
            };
        };

        const resize = () => {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = canvas.clientWidth;
            h = canvas.clientHeight;
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const count = Math.round(Math.min(40, Math.max(14, w / 38)));
            while (petals.length < count) petals.push(spawn(true));
            petals.length = count;
        };

        let last = 0;
        let running = false;
        let raf = 0;

        const frame = (now: number) => {
            const dt = Math.min((now - last) / 1000, 0.05);
            last = now;
            ctx.clearRect(0, 0, w, h);
            const dpr = canvas.width / w;
            for (let i = 0; i < petals.length; i++) {
                const p = petals[i];
                p.y += p.vy * dt;
                p.phase += p.swaySpeed * dt;
                p.rot += p.vrot * dt;
                p.flip += p.vflip * dt;
                const x = p.x + Math.sin(p.phase) * p.sway;
                if (p.y > h + p.size * 2) {
                    petals[i] = spawn(false);
                    continue;
                }
                // 裏返りながら舞うように、横幅を周期的に潰す
                const scaleX = Math.cos(p.flip);
                const scale = p.size / SPRITE;
                ctx.globalAlpha = p.alpha * (0.55 + 0.45 * Math.abs(scaleX));
                ctx.setTransform(dpr, 0, 0, dpr, x * dpr, p.y * dpr);
                ctx.rotate(p.rot);
                ctx.scale(scale * (0.2 + 0.8 * Math.abs(scaleX)), scale);
                ctx.drawImage(p.sprite, -SPRITE, -SPRITE);
            }
            ctx.globalAlpha = 1;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            raf = requestAnimationFrame(frame);
        };

        const start = () => {
            if (running) return;
            running = true;
            last = performance.now();
            raf = requestAnimationFrame(frame);
        };
        const stop = () => {
            running = false;
            cancelAnimationFrame(raf);
        };

        resize();
        new ResizeObserver(resize).observe(canvas);

        // ヒーローが見えていて、タブが表示中のときだけ動かす
        let visible = true;
        const sync = () => (visible && !document.hidden ? start() : stop());
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            sync();
        }).observe(canvas);
        document.addEventListener('visibilitychange', sync);
    }
</script>

<style>
    .hero-petals {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 65%, transparent 100%);
        mask-image: linear-gradient(to bottom, #000 0%, #000 65%, transparent 100%);
    }
</style>
