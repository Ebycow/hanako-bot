---
import { limits, fmt } from '../../data/limits';
---

<!-- 料金は無料なので、プランの比較ではなく、はなことの「なかよし度」で使い方の段階を並べる -->
<section class="section" id="pricing">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">Pricing</span>
            <h2>料金は、<span class="hl">かかりません。</span></h2>
            <p>どれだけ使いこなしても、ずっと無料です。かわりに、はなことの「なかよし度」を3段階で並べてみました。</p>
        </div>
        <div class="pricing">
            <article class="card price-card reveal">
                <span class="level">なかよし度 Lv.1</span>
                <h3>はじめまして</h3>
                <p>まずは呼んで、話してみる。</p>
                <div class="price">¥0<small> / ずっと</small></div>
                <ul>
                    <li><code>/plz</code>で呼んで、<code>/bye</code>で帰す</li>
                    <li>チャットの発言を、その場で読み上げ</li>
                    <li>長い読み上げは<code>/seibai</code>で止める</li>
                </ul>
                <a class="btn btn-ghost" href="docs.html#start">始め方を読む</a>
            </article>
            <article class="card price-card featured reveal">
                <span class="badge">ここを目指そう</span>
                <span class="level">なかよし度 Lv.2</span>
                <h3>なかよし</h3>
                <p>サーバーの言葉を教えて、なじませる。</p>
                <div class="price"><span class="hl">¥0</span><small> / ずっと</small></div>
                <ul>
                    <li>内輪の呼び名を辞書で教える（{fmt(limits.dictionaryEntries)}件まで）</li>
                    <li>キーワードでSEを鳴らす（{fmt(limits.seEntries)}件まで）</li>
                    <li><code>/speaker</code>で声を変える</li>
                </ul>
                <a class="btn btn-primary" href="docs.html#dictionary">辞書とSEの使い方</a>
            </article>
            <article class="card price-card reveal">
                <span class="level">なかよし度 Lv.3</span>
                <h3>相棒</h3>
                <p>サーバーの一員として、まかせる。</p>
                <div class="price">¥0<small> / ずっと</small></div>
                <ul>
                    <li>SE正規化で音量をそろえる</li>
                    <li>ブラックリストと権限で管理する</li>
                    <li>自分のサーバーでホストする</li>
                </ul>
                <a class="btn btn-ghost" href="developers.html#self-host">自分でホストする方法</a>
            </article>
        </div>
        <p class="fineprint">※ なかよし度はただの目安です。どの段階でも料金はかからず、使える機能も同じです。</p>
    </div>
</section>

<style>
    .pricing {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        align-items: stretch;
    }

    .price-card {
        display: flex;
        flex-direction: column;
    }

    .price-card.featured {
        background: var(--pink-pale);
        border: 3px solid var(--pink);
        box-shadow: 0 8px 0 var(--pink-soft);
    }

    .price-card .badge {
        position: absolute;
        top: 18px;
        right: 18px;
        font-size: var(--fs-xs);
        font-weight: 900;
        padding: 2px 12px;
        border-radius: var(--radius-pill);
        background: var(--pink-ink);
        color: var(--on-accent);
        transform: rotate(4deg);
    }

    /* なかよし度の段階 */
    .level {
        display: inline-block;
        align-self: flex-start;
        margin-bottom: 10px;
        padding: 1px 12px;
        border-radius: var(--radius-pill);
        background: var(--mint-soft);
        color: var(--mint-ink);
        font-size: var(--fs-xs);
        font-weight: 900;
        letter-spacing: 0.06em;
    }

    .featured .level {
        background: var(--surface);
        color: var(--pink-ink);
    }

    .price {
        font-size: var(--fs-h2);
        font-weight: 900;
        margin: 8px 0 4px;
        line-height: 1.2;
    }

    .price small {
        font-size: var(--fs-base);
        color: var(--text-muted);
        font-weight: 700;
    }

    .price-card ul {
        list-style: none;
        padding: 0;
        margin: 18px 0 24px;
        flex: 1;
    }

    .price-card li {
        padding: 6px 0 6px 28px;
        position: relative;
        color: var(--text);
        font-size: var(--fs-md);
        border-bottom: 1px dashed var(--border);
    }

    .price-card li::before {
        content: '✿';
        position: absolute;
        left: 2px;
        color: var(--pink);
    }

    .price-card .btn {
        justify-content: center;
    }

    @media (max-width: 960px) {
        .pricing {
            grid-template-columns: 1fr;
        }
    }
</style>
