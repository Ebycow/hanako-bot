---
// 開発者向けページ（developers.html）への入口。本文はトップページに載せず、中身の一覧だけを見せる。
// 以前の ./#developers へのリンクで来た人がここに着くよう、id は developers のままにしておく
import Img from '../Img.astro';

const topics = [
    { id: 'partner', image: 'hanako-ebyroid-duo.webp', title: '相棒のEbyroid', text: 'はなこの声を作っている音声サーバーの紹介です。' },
    { id: 'self-host', image: 'ebyroid-typing.webp', title: '自分でホストする', text: '自分の環境で動かすまでの4ステップと、必要なものです。' },
    { id: 'ask-ai', image: 'ebyroid-minihanako.webp', title: 'AIに相談する', text: '準備や機能の追加を、いつものAIに手伝ってもらえます。' },
];
---

<section class="section" id="developers">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">For Developers</span>
            <h2>はなこを、<span class="hl">あなたの手で。</span></h2>
            <p>HanakoのソースコードはGitHubで公開しています。自分のサーバーで動かしたい方や、機能を足したい方は開発者向けページをどうぞ。</p>
        </div>

        <ul class="dev-links">
            {
                topics.map((t) => (
                    <li class="reveal">
                        <a href={`developers.html#${t.id}`}>
                            <Img src={t.image} alt="" width={64} />
                            <span class="text">
                                <b>{t.title}</b>
                                <span>{t.text}</span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="hero-actions center">
            <a class="btn btn-primary" href="developers.html">開発者向けページを見る →</a>
        </div>
    </div>
</section>

<style>
    .dev-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .dev-links a {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
        padding: 18px 20px;
        border-radius: var(--radius);
        background: var(--surface);
        border: 2px solid var(--border);
        box-shadow: var(--pop);
        color: var(--text);
        transition:
            transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1),
            border-color 0.25s,
            box-shadow 0.25s;
    }

    .dev-links a:hover {
        color: var(--text);
        transform: translateY(-3px);
        border-color: var(--border-strong);
        box-shadow: var(--pop-hover);
    }

    .dev-links img {
        flex-shrink: 0;
        width: 64px;
        height: 64px;
        object-fit: cover;
        object-position: top;
        border-radius: 50%;
        background: var(--lavender-soft);
        border: 2px solid var(--lavender-line);
    }

    .text {
        display: grid;
        line-height: 1.6;
    }

    .text b {
        font-size: var(--fs-body);
        font-weight: 900;
    }

    .text span {
        margin-top: 2px;
        color: var(--text-muted);
        font-size: var(--fs-md);
    }

    .hero-actions {
        margin-top: 34px;
    }

    @media (max-width: 960px) {
        .dev-links {
            grid-template-columns: 1fr;
        }
    }
</style>
