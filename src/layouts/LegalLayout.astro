---
import BaseLayout from './BaseLayout.astro';

interface Props {
    page: 'terms' | 'privacy';
    title: string;
    description: string;
    image: string;
    eyebrow: string;
    heading: string;
    lead: string;
    /** 制定日・改定日 */
    date: string;
    highlights: { icon: string; title: string; text: string }[];
}

const { page, title, description, image, eyebrow, heading, lead, date, highlights } = Astro.props;
---

<BaseLayout page={page} title={title} description={description}>
    <section class="doc-hero container">
        <img src={image} alt="花子" />
        <br /><span class="eyebrow">{eyebrow}</span>
        <h1><span class="hl">{heading}</span></h1>
        <p>{lead}</p>
        <p class="doc-meta">📅 {date}</p>
    </section>

    <div class="container">
        <div class="highlights">
            {highlights.map((h) => (
                <div class="card">
                    <div class="icon-box">{h.icon}</div>
                    <b>{h.title}</b>
                    <span>{h.text}</span>
                </div>
            ))}
        </div>
    </div>

    <article class="container doc">
        <slot />
    </article>
</BaseLayout>

<style>
    .doc-hero {
        padding: 80px 0 30px;
        text-align: center;
    }

    .doc-hero img {
        width: 150px;
        filter: drop-shadow(0 8px 14px rgba(214, 51, 111, 0.25));
    }

    .doc-hero h1 {
        font-size: clamp(32px, 4.8vw, 54px);
        line-height: 1.35;
        margin: 10px 0 14px;
    }

    .doc-hero p {
        color: var(--text-muted);
        font-size: 17px;
        margin: 0 auto;
        max-width: 620px;
    }

    .doc-meta {
        display: inline-block;
        margin-top: 18px !important;
        font-size: 13px !important;
        font-weight: 700;
        padding: 3px 16px;
        border-radius: 999px;
        background: var(--surface);
        border: 2px solid var(--border);
    }

    .highlights {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        max-width: 900px;
        margin: 30px auto 50px;
    }

    .highlights .card {
        padding: 22px;
    }

    .highlights .card b {
        display: block;
        margin-bottom: 4px;
    }

    .highlights .card span {
        color: var(--text-muted);
        font-size: 14px;
    }

    /* 本文。Markdown から作られる要素には :global() で効かせる */
    .doc {
        max-width: 860px;
        margin: 0 auto;
        padding: 40px 44px;
        border-radius: var(--radius-lg);
        background: var(--surface);
        border: 2px solid var(--border);
        box-shadow: var(--pop);
    }

    .doc :global(h2) {
        font-size: 21px;
        margin: 44px 0 14px;
        padding-top: 28px;
        border-top: 2px dashed var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .doc :global(h2::before) {
        content: '';
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--pink);
        box-shadow: 0 0 0 4px var(--pink-soft);
        flex-shrink: 0;
    }

    .doc :global(h2:first-of-type) {
        margin-top: 30px;
    }

    .doc :global(p),
    .doc :global(li) {
        color: var(--text);
    }

    .doc :global(li) {
        margin-bottom: 8px;
    }

    @media (max-width: 960px) {
        .highlights {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .doc {
            padding: 26px 20px;
        }
    }
</style>
