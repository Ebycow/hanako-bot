---
import '../styles/global.css';
import SiteHeader, { type Page } from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
    page: Page;
    title: string;
    description: string;
    ogTitle?: string;
    ogDescription?: string;
}

const { page, title, description, ogTitle = title, ogDescription = description } = Astro.props;

// OGP と canonical は絶対URLで書く（astro.config.mjs の site と base から組み立てる）
const siteRoot = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site);
const pageUrl = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
// 共有したときの画像は全ページ共通。差し替えるときは、SNS のキャッシュに残らないようファイル名ごと変える
const ogImage = new URL('assets/og-2.jpg', siteRoot);
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {/* JavaScriptが動くときだけ、スクロールで出てくる演出のために要素を隠す（reveal.css）。
            「動きを止める」設定（src/scripts/motion.ts）も、描画の前に反映しておく */}
        <script is:inline>
            (function () {
                var root = document.documentElement;
                root.classList.add('js');
                var saved = null;
                try {
                    saved = localStorage.getItem('hanako-motion');
                } catch (e) {}
                if (saved === 'off' || (saved !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                    root.classList.add('motion-off');
                }
            })();
        </script>
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={pageUrl} />
        <meta property="og:site_name" content="Hanako" />
        <meta property="og:locale" content="ja_JP" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="ヘッドセットのマイクを付けて、口元に手を添えて楽しそうに呼びかける猫耳のはなこ。「Hanako Discordのチャットを読み上げるBot」の文字" />
        <meta name="twitter:card" content="summary_large_image" />
        {/* Discord では、共有したときの埋め込みの帯の色にもなる */}
        <meta name="theme-color" content="#f47aa9" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700;900&display=swap" rel="stylesheet" />
        {/* ロゴ専用の丸ゴシック。使う文字だけを読み込む */}
        <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@900&text=HanakoTTS&display=swap" rel="stylesheet" />
        <link rel="icon" type="image/png" href="assets/favicon.png" />
        <link rel="apple-touch-icon" href="assets/apple-touch-icon.png" />
    </head>
    <body>
        <a class="skip-link" href="#main">本文へスキップ</a>
        <div class="orb orb-1" aria-hidden="true"></div>
        <div class="orb orb-2" aria-hidden="true"></div>
        <div class="orb orb-3" aria-hidden="true"></div>
        <slot name="before-header" />

        <SiteHeader page={page} />

        <main id="main">
            <slot />
        </main>

        <SiteFooter page={page} />

        <slot name="after-footer" />
    </body>
</html>

<script>
    // スクロールリビール
    const items = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
    } else {
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('in');
                    io.unobserve(entry.target);
                });
            },
            { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
    }
</script>

<style>
    /* キーボードで Tab を押したときだけ左上に出る */
    .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 100;
        padding: 8px 18px;
        border-radius: var(--radius-pill);
        background: var(--pink-ink);
        color: var(--on-accent);
        font-weight: 900;
        transform: translateY(-200%);
    }

    .skip-link:focus {
        color: var(--on-accent);
        transform: none;
    }

    /* 背景にふわっと浮かぶ色の玉（桃色・ミント・ラベンダー） */
    .orb {
        position: fixed;
        z-index: -1;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.45;
        pointer-events: none;
        /* 読み込んだときに一度だけ漂って止まる（飾りの動きは5秒以内で止める） */
        animation: orb-float 5s ease-out forwards;
    }

    .orb-1 {
        width: 520px;
        height: 520px;
        top: -200px;
        left: -160px;
        background: rgb(var(--glow-pink));
    }

    .orb-2 {
        width: 440px;
        height: 440px;
        top: 20%;
        right: -180px;
        background: rgb(var(--glow-mint));
    }

    .orb-3 {
        width: 400px;
        height: 400px;
        bottom: -180px;
        left: 30%;
        background: rgb(var(--glow-lavender));
    }

    @keyframes orb-float {
        to {
            transform: translate(50px, 70px) scale(1.1);
        }
    }
</style>
