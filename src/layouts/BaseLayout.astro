---
import '../styles/global.css';
import SiteHeader, { type Page } from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
    page: Page;
    title: string;
    description: string;
    ogTitle?: string;
    ogDescription?: string;
}

const { page, title, description, ogTitle, ogDescription } = Astro.props;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <!-- JavaScriptが動くときだけ、スクロールで出てくる演出のために要素を隠す（reveal.css） -->
        <script is:inline>document.documentElement.classList.add('js');</script>
        <title>{title}</title>
        <meta name="description" content={description} />
        {ogTitle && <meta property="og:title" content={ogTitle} />}
        {ogDescription && <meta property="og:description" content={ogDescription} />}
        {ogTitle && <meta property="og:type" content="website" />}
        <meta name="theme-color" content="#fff8fb" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700;900&display=swap" rel="stylesheet" />
        <!-- ロゴ専用の丸ゴシック。使う文字だけを読み込む -->
        <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@900&text=HanakoTTS&display=swap" rel="stylesheet" />
        <link rel="icon" type="image/png" href="assets/favicon.png" />
        <link rel="apple-touch-icon" href="assets/apple-touch-icon.png" />
    </head>
    <body>
        <a class="skip-link" href="#main">本文へスキップ</a>
        <div class="orb orb-1" aria-hidden="true"></div>
        <div class="orb orb-2" aria-hidden="true"></div>
        <div class="orb orb-3" aria-hidden="true"></div>
        <slot name="before-header" />

        <SiteHeader page={page} />

        <main id="main">
            <slot />
        </main>

        <SiteFooter page={page} />

        <slot name="after-footer" />
    </body>
</html>

<script>
    // スクロールリビール
    const items = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
    } else {
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('in');
                    io.unobserve(entry.target);
                });
            },
            { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
    }
</script>

<style>
    /* キーボードで Tab を押したときだけ左上に出る */
    .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 100;
        padding: 8px 18px;
        border-radius: var(--radius-pill);
        background: var(--pink-ink);
        color: var(--on-accent);
        font-weight: 900;
        transform: translateY(-200%);
    }

    .skip-link:focus {
        color: var(--on-accent);
        transform: none;
    }

    /* 背景にふわっと浮かぶ色の玉（桃色・ミント・ラベンダー） */
    .orb {
        position: fixed;
        z-index: -1;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.45;
        pointer-events: none;
        animation: orb-float 18s ease-in-out infinite alternate;
    }

    .orb-1 {
        width: 520px;
        height: 520px;
        top: -200px;
        left: -160px;
        background: rgb(var(--glow-pink));
    }

    .orb-2 {
        width: 440px;
        height: 440px;
        top: 20%;
        right: -180px;
        background: rgb(var(--glow-mint));
        animation-delay: -6s;
    }

    .orb-3 {
        width: 400px;
        height: 400px;
        bottom: -180px;
        left: 30%;
        background: rgb(var(--glow-lavender));
        animation-delay: -12s;
    }

    @keyframes orb-float {
        to {
            transform: translate(50px, 70px) scale(1.1);
        }
    }
</style>
