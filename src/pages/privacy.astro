---
import LegalLayout from '../layouts/LegalLayout.astro';
import { Content } from '../content/privacy.md';
---

<LegalLayout
    page="privacy"
    title="プライバシーポリシー | Hanako 読み上げBot"
    description="Discordのチャット読み上げBot「Hanako」のプライバシーポリシーです。"
    image="hanako-privacy.webp"
    eyebrow="Privacy Policy"
    heading="プライバシーポリシー"
    lead="利用者のプライバシーをいちばんに考えています。Hanakoが扱う情報について、ここで説明します。"
    date="制定日：2026年10月1日"
    highlights={[
        { icon: '🔒', title: '本文は保存しない', text: 'メッセージの本文は保存しません。' },
        { icon: '🏠', title: 'サーバーごとに分離', text: '辞書・SE・設定はサーバーごとに分けて保存します。' },
        { icon: '🍪', title: 'Cookieなし', text: 'このサイトはCookieも解析ツールも使っていません。' },
    ]}
>
    <Content />
</LegalLayout>
