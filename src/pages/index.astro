---
import BaseLayout from '../layouts/BaseLayout.astro';
import CursorGlow from '../components/home/CursorGlow.astro';
import Hero from '../components/home/Hero.astro';
import VoiceDemo from '../components/home/VoiceDemo.astro';
import UseCases from '../components/home/UseCases.astro';
import Features from '../components/home/Features.astro';
import SeInsight from '../components/home/SeInsight.astro';
import DocsTeaser from '../components/home/DocsTeaser.astro';
import Compare from '../components/home/Compare.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Pricing from '../components/home/Pricing.astro';
import Expressions from '../components/home/Expressions.astro';
import DevelopersTeaser from '../components/home/DevelopersTeaser.astro';
import Cta from '../components/home/Cta.astro';
import Maintainer from '../components/home/Maintainer.astro';
import InviteModal from '../components/home/InviteModal.astro';
import Operator from '../components/home/Operator.astro';
---

<BaseLayout
    page="home"
    title="Hanako | Discordのチャット読み上げBot"
    description="Hanakoは、Discordのテキストチャットをボイスチャンネルで読み上げるBotです。読み方を教える辞書や、キーワードで鳴るSE（効果音）、読み上げない人を決めるブラックリストも使えます。"
    ogTitle="Hanako | Discordのチャット読み上げBot"
    ogDescription="言葉に、声という花を。Discordのチャットを読み上げるBot「Hanako」の紹介と使い方です。"
>
    <Fragment slot="before-header">
        <CursorGlow />
        <aside class="announce" aria-label="お知らせ">
            <b>Hanako</b>は、Discordのチャットを読み上げるBotです。<a href="#features">できることを見る →</a>
        </aside>
    </Fragment>

    <Hero />
    <VoiceDemo />
    <UseCases />
    <Features />
    <SeInsight />
    <DocsTeaser />
    <Compare />
    <Testimonials />
    <Pricing />
    <Expressions />
    <DevelopersTeaser />
    <Cta />
    <Maintainer />

    <Fragment slot="after-footer">
        <InviteModal />
        <Operator />
    </Fragment>
</BaseLayout>

<style>
    .announce {
        position: relative;
        z-index: 30;
        text-align: center;
        font-size: var(--fs-md);
        font-weight: 700;
        padding: 8px 16px;
        background: var(--pink-ink);
        color: var(--on-accent);
    }

    /* 指で押しやすいよう、リンクの高さを 24px 以上にする */
    .announce a {
        display: inline-block;
        padding: 2px 0;
        color: var(--on-accent);
        margin-left: 6px;
        text-decoration: underline;
        text-decoration-style: wavy;
        text-underline-offset: 4px;
    }

    .announce a:hover {
        color: var(--pink-soft);
    }
</style>
